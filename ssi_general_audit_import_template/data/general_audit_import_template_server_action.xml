<odoo noupdate="1">

    <!-- Create the download server actions once, at installation only. The
         file is noupdate, so Odoo runs this call in init mode only: a later
         -u does not recreate a server action that was removed or unbound. -->
    <function
        model="general_audit_import_template"
        name="action_create_server_action"
        eval="[[
            ref('general_audit_import_template_client_account_mapping'),
            ref('general_audit_import_template_client_trial_balance'),
            ref('general_audit_import_template_client_adjustment_entry'),
        ]]"
    />

</odoo>
