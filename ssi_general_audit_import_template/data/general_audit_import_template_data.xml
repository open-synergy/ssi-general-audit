<odoo noupdate="1">

    <record
        id="general_audit_import_template_client_account_mapping"
        model="general_audit_import_template"
    >
        <field name="name">CoA And Mapping</field>
        <field name="code">CLIENT_ACCOUNT_MAPPING</field>
        <field name="model_id" ref="ssi_general_audit.model_client_account_mapping" />
        <field name="file_name">client_account_mapping.csv</field>
        <field name="delimiter">,</field>
        <field name="has_header" eval="True" />
    </record>

    <record
        id="general_audit_import_template_client_account_mapping_line_1"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_account_mapping"
        />
        <field name="sequence">5</field>
        <field name="name">Account Code</field>
        <field name="example_value">1.1.1.02</field>
        <field name="note">Account code of the client.</field>
    </record>

    <record
        id="general_audit_import_template_client_account_mapping_line_2"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_account_mapping"
        />
        <field name="sequence">10</field>
        <field name="name">Account Name</field>
        <field name="example_value">Kas Besar</field>
        <field name="note">Account name of the client.</field>
    </record>

    <record
        id="general_audit_import_template_client_account_mapping_line_3"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_account_mapping"
        />
        <field name="sequence">15</field>
        <field name="name">Reserved (ignored by import)</field>
        <field name="example_value">10</field>
        <field name="note">Reserved column, ignored by the import.</field>
    </record>

    <record
        id="general_audit_import_template_client_account_mapping_line_4"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_account_mapping"
        />
        <field name="sequence">20</field>
        <field name="name">Account Type Code</field>
        <field name="example_value">S111</field>
        <field name="note">Code of the client account type.</field>
    </record>

    <record
        id="general_audit_import_template_client_account_mapping_line_5"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_account_mapping"
        />
        <field name="sequence">25</field>
        <field name="name">Balance Side</field>
        <field name="example_value">dr</field>
        <field name="note">Balance side, dr or cr. Ignored by the import.</field>
    </record>

