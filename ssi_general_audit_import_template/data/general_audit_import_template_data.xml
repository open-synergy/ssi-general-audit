    <record
        id="general_audit_import_template_client_adjustment_entry_line_5"
        model="general_audit_import_template.line"
    >
        <field
            name="template_id"
            ref="general_audit_import_template_client_adjustment_entry"
        />
        <field name="sequence">25</field>
        <field name="name">Credit</field>
        <field name="example_value" />
        <field name="note">Credit amount.</field>
    </record>

    <!-- Create the download server actions once, at installation only. The
         file is noupdate, so Odoo runs this call in init mode only: a
         later -u does not recreate a server action an admin removed. -->
    <function
        model="general_audit_import_template"
        name="action_create_server_action"
        eval="[[
            ref('general_audit_import_template_client_account_mapping'),
            ref('general_audit_import_template_client_trial_balance'),
            ref('general_audit_import_template_client_adjustment_entry'),
        ]]"
    />

</odoo>
