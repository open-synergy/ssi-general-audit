<odoo>

    <record id="client_adjustment_entry_readonly_view_tree" model="ir.ui.view">
        <field name="name">client_adjustment_entry readonly tree</field>
        <field name="model">client_adjustment_entry</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.client_adjustment_entry_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>
            </data>
        </field>
    </record>

    <record id="client_adjustment_entry_readonly_view_form" model="ir.ui.view">
        <field name="name">client_adjustment_entry readonly form</field>
        <field name="model">client_adjustment_entry</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.client_adjustment_entry_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//form" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
