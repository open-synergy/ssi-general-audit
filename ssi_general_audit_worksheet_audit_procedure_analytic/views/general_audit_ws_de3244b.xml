<odoo>

    <record id="general_audit_ws_de3244b_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_de3244b form</field>
        <field name="model">general_audit_ws_de3244b</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_de3244b_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_de3244b tree</field>
        <field name="model">general_audit_ws_de3244b</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                    <field name="key_audit_procedure_id" />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        optional="hide"
                    />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de3244b_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_de3244b form</field>
        <field name="model">general_audit_ws_de3244b</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field
                        name="ws_e51bb1c_id"
                        domain="[('general_audit_id', '=', general_audit_id),('state','in',['open','done'])]"
                    />
                    <field
                        name="allowed_account_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                    />
                    <field
                        name="allowed_key_audit_procedure_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="key_audit_procedure_id"
                        domain="[('id', 'in', allowed_key_audit_procedure_ids)]"
                    />
                    <field name="detail_ws_e51bb1c_id" invisible="1" />
                    <field
                        name="allowed_assertion_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        domain="[('id','in', allowed_assertion_type_ids)]"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                </xpath>
                <xpath expr="//notebook" position="after">
                    <group string="Worksheet Result" colspan="4" col="1">
                        <field
                            name="worksheet_result"
                            nolabel="1"
                            widget="html"
                            colspan="1"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de3244b_action" model="ir.actions.act_window">
        <field name="name">Comparative Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_de3244b</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_de3244b_menu"
        name="Comparatives"
        parent="ssi_general_audit_worksheet_audit_procedure_analytic.general_audit_ws_aa899baf_menu"
        action="general_audit_ws_de3244b_action"
        sequence="2"
        groups="general_audit_ws_de3244b_viewer_group"
    />
</odoo>
