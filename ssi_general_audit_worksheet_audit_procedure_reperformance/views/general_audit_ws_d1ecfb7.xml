<odoo>

    <record id="general_audit_ws_d1ecfb7_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_d1ecfb7 form</field>
        <field name="model">general_audit_ws_d1ecfb7</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_d1ecfb7_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_d1ecfb7 tree</field>
        <field name="model">general_audit_ws_d1ecfb7</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                    <field name="key_audit_procedure_id" />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        optional="hide"
                    />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d1ecfb7_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_d1ecfb7 form</field>
        <field name="model">general_audit_ws_d1ecfb7</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field
                        name="ws_e51bb1c_id"
                        domain="[('general_audit_id', '=', general_audit_id),('state','in',['open','done'])]"
                    />
                    <field
                        name="allowed_account_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                    />
                    <field
                        name="allowed_key_audit_procedure_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="key_audit_procedure_id"
                        domain="[('id', 'in', allowed_key_audit_procedure_ids)]"
                    />
                    <field name="detail_ws_e51bb1c_id" invisible="1" />
                    <field
                        name="allowed_assertion_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        domain="[('id','in', allowed_assertion_type_ids)]"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="background" string="Background">
                        <field name="background" widget="html" nolabel="1" />
                    </page>
                    <page
                        name="procedure_control"
                        string="Procedure / Control Re-performed"
                    >
                        <field name="procedure_control" widget="html" nolabel="1" />
                    </page>
                    <page name="steps" string="Re-performance Steps">
                        <field name="step_ids">
                            <tree>
                                <field name="sequence" widget="handle" />
                                <field
                                    name="procedure_step"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field
                                    name="reperformance_result"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                            </tree>
                            <form>
                                <group>
                                    <field name="sequence" />
                                </group>
                                <notebook>
                                    <page name="step_result" string="Step &amp; Result">
                                        <separator string="Procedure / Control Step" />
                                        <field name="procedure_step" />
                                        <separator string="Re-performance Result" />
                                        <field
                                            name="reperformance_result"
                                            widget="html"
                                            nolabel="1"
                                        />
                                    </page>
                                </notebook>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//notebook" position="after">
                    <group string="Worksheet Result" colspan="4" col="1">
                        <field
                            name="worksheet_result"
                            nolabel="1"
                            widget="html"
                            colspan="1"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d1ecfb7_action" model="ir.actions.act_window">
        <field name="name">Reperformance Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_d1ecfb7</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_d1ecfb7_menu"
        name="Reperformances"
        parent="ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_root_menu"
        action="general_audit_ws_d1ecfb7_action"
        sequence="120"
        groups="general_audit_ws_d1ecfb7_viewer_group"
    />
</odoo>
