<odoo>

    <record id="ownership_location_view_search" model="ir.ui.view">
        <field name="name">ownership_location - search</field>
        <field name="model">ownership_location</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="ownership_location_view_tree" model="ir.ui.view">
        <field name="name">ownership_location - tree</field>
        <field name="model">ownership_location</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="ownership_location_view_form" model="ir.ui.view">
        <field name="name">ownership_location - form</field>
        <field name="model">ownership_location</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="ownership_location_action" model="ir.actions.act_window">
        <field name="name">Ownership Location</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ownership_location</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ownership_location_menu"
        name="Ownership Location"
        parent="ssi_general_audit.menu_configuration_option_category"
        action="ownership_location_action"
        sequence="150"
        groups="ownership_location_configurator"
    />

</odoo>
