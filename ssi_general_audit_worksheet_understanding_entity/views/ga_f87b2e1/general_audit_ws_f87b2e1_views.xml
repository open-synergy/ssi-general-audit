    <record id="general_audit_ws_f87b2e1_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f87b2e1 form</field>
        <field name="model">general_audit_ws_f87b2e1</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="activity" string="Activities">
                        <button
                            name="action_reload_links"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft','open'])]}"
                        />
                        <group
                            name="activity_1"
                            string="General Information and Legal Aspec"
                        >
                            <label for="link_1_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_1_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_1_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_1_state" class="oe_inline" />
                            </div>
                            <field name="link_1_conclusion" string="Conclusion" />
                        </group>
                        <group
                            name="activity_2"
                            string="Structure Organization and Responsibilities"
                        >
                            <label for="link_2_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_2_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_2_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_2_state" class="oe_inline" />
                            </div>
                            <field name="link_2_conclusion" string="Conclusion" />
                        </group>
                        <group
                            name="activity_3"
                            string="Main Business Activity Process"
                        >
                            <label for="link_3_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_3_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_3_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_3_state" class="oe_inline" />
                            </div>
                            <field name="link_3_conclusion" string="Conclusion" />
                        </group>
                        <group
                            name="activity_4"
                            string="Understanding of Relevant Regulations"
                        >
                            <label for="link_4_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_4_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_4_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_4_state" class="oe_inline" />
                            </div>
                            <field name="link_4_conclusion" string="Conclusion" />
                        </group>
                        <group
                            name="activity_5"
                            string="Understanding of The Business Environment"
                        >
                            <field
                                name="link_5_ids"
                                widget="many2many_tree"
                                nolabel="1"
                            >
                                <tree>
                                    <field name="name" />
                                    <field name="business_environment_id" />
                                    <field name="state" />
                                    <field name="conclusion" string="Conclusion" />
                                </tree>
                            </field>
                        </group>
                        <group name="activity_6" string="Going Concern Analysis">
                            <label for="link_6_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_6_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_6_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_6_state" class="oe_inline" />
                            </div>
                            <field name="link_6_conclusion" string="Conclusion" />
                        </group>
                        <group
                            name="activity_7"
                            string="Understanding of Preparation of Financial Statements"
                        >
                            <label for="link_7_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_7_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_7_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_7_state" class="oe_inline" />
                            </div>
                            <field name="link_7_conclusion" string="Conclusion" />
                        </group>
                        <group name="activity_8" string="Fraud Factor Analysis">
                            <label for="link_8_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="link_8_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="link_8_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="link_8_state" class="oe_inline" />
                            </div>
                            <field name="link_8_conclusion" string="Conclusion" />
                        </group>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f87b2e1_action" model="ir.actions.act_window">
        <field name="name">Understanding of The Entity and it's Environment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_f87b2e1</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_f87b2e1_menu"
        name="Understanding of The Entity and it's Environment"
        parent="ssi_general_audit.menu_general_audit_understanding_entity"
        action="general_audit_ws_f87b2e1_action"
        sequence="1"
        groups="general_audit_ws_f87b2e1_viewer_group"
    />
</odoo>
