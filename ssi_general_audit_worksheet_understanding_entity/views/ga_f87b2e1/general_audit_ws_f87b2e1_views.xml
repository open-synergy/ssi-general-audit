<odoo>

    <record id="general_audit_ws_f87b2e1_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f87b2e1 form</field>
        <field name="model">general_audit_ws_f87b2e1</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_f87b2e1_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f87b2e1 tree</field>
        <field name="model">general_audit_ws_f87b2e1</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
