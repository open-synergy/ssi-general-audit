<odoo>

    <record id="general_audit_ws_a916660_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a916660 form</field>
        <field name="model">general_audit_ws_a916660</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_a916660_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a916660 tree</field>
        <field name="model">general_audit_ws_a916660</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="data_mode" optional="hide" />
                    <field name="method_type" optional="show" />
                    <field name="general_ledger_id" optional="hide" />
                    <field name="subledger_id" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a916660_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a916660 form</field>
        <field name="model">general_audit_ws_a916660</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field name="data_mode" />
                    <field name="method_type" />
                    <field name="allowed_general_ledger_ids" invisible="1" />
                    <field
                        name="general_ledger_id"
                        domain="[('id', 'in', allowed_general_ledger_ids)]"
                        attrs="{'invisible': [('data_mode', '!=', 'gl')]}"
                    />
                    <field name="allowed_subledger_ids" invisible="1" />
                    <field
                        name="subledger_id"
                        domain="[('id', 'in', allowed_subledger_ids)]"
                        attrs="{'invisible': [('data_mode', '!=', 'subledger')]}"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="data" string="Data">
                        <button
                            name="action_generate_sampling"
                            type="object"
                            string="Generate Sampling"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <div
                            class="alert alert-info"
                            role="alert"
                            attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                        >
                            <strong>How Input Variabel and Parameters feed
                            the Monetary Unit Sampling formula:</strong>
                            <ul class="mb-0">
                                <li><strong>Performance Materiality</strong>
                                and <strong>Risk Factor</strong> are manual
                                inputs (your professional judgment).
                                <strong>Tolerable Misstatement</strong>
                                auto-fills as Performance Materiality x
                                Risk Factor when either changes, but you
                                can still type over it directly.</li>
                                <li><strong>Confidence Factor</strong> (in
                                Parameters) is also a manual input -- it
                                is not looked up from any table, unlike
                                Classical Variable / Non-Statistical
                                Sampling's ARIA/ARIR.</li>
                                <li><strong>Sampling Interval</strong>
                                computes automatically as Tolerable
                                Misstatement / (Risk Factor / 30%) /
                                Confidence Factor -- it decides how many
                                items get selected (larger interval, fewer
                                items) and is the threshold each item's
                                cumulative amount is walked against.</li>
                                <li><strong>Multiplier Random</strong> is a
                                manual input: the upper bound for
                                <strong>Random</strong>, which is redrawn
                                every time you click "Generate Sampling"
                                and used as the walk's starting point --
                                see Random's own help text for how it
                                interacts with Sampling Interval to pick
                                items.</li>
                            </ul>
                        </div>
                        <div
                            class="alert alert-info"
                            role="alert"
                            attrs="{'invisible': [('method_type', 'not in', ['cvs', 'nss'])]}"
                        >
                            <strong>How Input Variabel and Parameters feed
                            the sample size formula:</strong>
                            <ul class="mb-0">
                                <li><strong>Performance Materiality</strong>
                                and <strong>Risk Factor</strong> are manual
                                inputs. <strong>Tolerable
                                Misstatement</strong> auto-fills as
                                Performance Materiality x Risk Factor when
                                either changes, but can still be typed
                                over directly.</li>
                                <li><strong>Estimate Misstatement</strong>
                                = Tolerable Misstatement x <strong
                                    >Estimate Misstatement Ratio</strong>, and
                                <strong>Standard Deviation Estimate</strong>
                                = Estimate Misstatement x <strong
                                    >Standard Deviation Ratio</strong> (both
                                ratios are manual inputs in Parameters,
                                defaulting to 0.55 and 0.013).</li>
                                <li><strong>ARIA</strong> and <strong
                                    >ARIR</strong> (Parameters) are picked from
                                a dropdown; their <strong>Coefficient</strong>
                                fields look up the matching value from the
                                standard confidence table automatically.</li>
                                <li><strong>Total Plan Examination</strong>
                                (key items + sample, on the "Sampling
                                Data" tab) = ROUNDUP(((Standard Deviation
                                Estimate x (ARIA Coefficient + ARIR
                                Coefficient) x Population Count) /
                                (Performance Materiality - Estimate
                                Misstatement))^2). <strong>Computed Sample
                                Size</strong> is that total minus Key Item
                                Count -- the number still to pick from the
                                pool.</li>
                                <li
                                    attrs="{'invisible': [('method_type', '!=', 'nss')]}"
                                ><strong>Final Sample Size
                                (Judgment)</strong> (Parameters) lets you
                                override the computed pool size with your
                                own figure -- leave it empty to use the
                                formula as-is.</li>
                            </ul>
                        </div>
                        <group name="data_1" colspan="4" col="2">
                            <group
                                name="data_1_1"
                                colspan="1"
                                col="2"
                                string="Input Variabel"
                            >
                                <field name="performance_materiality" />
                                <field name="risk_factor" />
                                <field name="tolerable_misstatement" />
                                <field
                                    name="estimate_misstatement"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                                <field
                                    name="standard_deviation_estimate"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                            </group>
                            <group
                                name="data_1_2"
                                colspan="1"
                                col="2"
                                string="Parameters"
                                attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                            >
                                <field name="confidence_factor" />
                                <field name="sampling_interval" />
                                <field name="multiplier_random" />
                                <field name="random_start" />
                            </group>
                            <group
                                name="data_1_3"
                                colspan="1"
                                col="2"
                                string="Parameters"
                                attrs="{'invisible': [('method_type', 'not in', ['cvs', 'nss'])]}"
                            >
                                <field name="aria" />
                                <field name="aria_coefficient" />
                                <field name="arir" />
                                <field name="arir_coefficient" />
                                <field name="estimate_misstatement_ratio" />
                                <field name="standard_deviation_ratio" />
                                <field
                                    name="nss_final_sample_size"
                                    attrs="{'invisible': [('method_type', '!=', 'nss')]}"
                                />
                            </group>
                        </group>
                        <group name="data_2" colspan="4" col="2">
                            <group
                                name="data_2_1"
                                colspan="1"
                                col="2"
                                string="Population"
                            >
                                <field name="population_count" />
                                <field name="population_amount" />
                            </group>
                            <group
                                name="data_2_2"
                                colspan="1"
                                col="2"
                                string="Key Items"
                            >
                                <field name="key_item_count" />
                                <field name="key_item_amount" />
                            </group>
                        </group>
                        <group name="data_3" colspan="4" col="2">
                            <group
                                name="data_3_1"
                                colspan="1"
                                col="2"
                                string="Sample Pool"
                            >
                                <field name="sample_count" />
                                <field name="sample_amount" />
                            </group>
                            <group
                                name="data_3_2"
                                colspan="1"
                                col="2"
                                string="Sample Size"
                            >
                                <field name="computed_sample_size" />
                            </group>
                        </group>
                        <group
                            name="data_1_bis"
                            colspan="4"
                            col="2"
                            string="Col. Number"
                        >
                            <field name="identifier_col_number" string="Identifier" />
                            <field name="monetary_col_number" string="Monetary" />
                            <field
                                name="additional_info_col_number"
                                string="Additional Info"
                            />
                        </group>
                        <field
                            name="raw_data"
                            nolabel="1"
                            widget="csv_table"
                            readonly="1"
                        />
                    </page>
                    <page
                        name="sampling_process"
                        string="Sampling Process"
                        attrs="{'invisible': [('method_type', '!=', 'nss')]}"
                    >
                        <div class="alert alert-warning" role="alert">
                            <strong>Choosing samples for Non-Statistical
                            Sampling:</strong>
                            <ul class="mb-0">
                                <li>Only <strong>Candidate</strong> rows
                                (not yet tested) appear here. <strong
                                    >Key Item</strong> rows are chosen
                                automatically (100% examination) and are
                                not shown.</li>
                                <li>Check <strong>Chose?</strong> to
                                promote a candidate to
                                <code>Sample</code>; uncheck to send it
                                back to <code>Candidate</code>.</li>
                                <li>The number chosen cannot exceed
                                <strong>Computed Sample Size</strong>
                                (already net of key items).</li>
                            </ul>
                        </div>
                        <div class="alert alert-info" role="alert">
                            <strong>WHERE Clause Guide (optional
                            filter):</strong>
                            <ul class="mb-0">
                                <li
                                >Spaces &amp; special characters in column names are replaced by <code
                                    >_</code> (e.g. "Additional Info" → <code
                                    >Additional_Info</code>)</li>
                                <li>Contains text: <code
                                    >Additional_Info LIKE '%FRONT WALL%'</code></li>
                                <li>Exact match: <code>Type = 'Candidate'</code></li>
                                <li>Greater / less than: <code>Amount > 1000</code></li>
                            </ul>
                        </div>
                        <field
                            name="sampling_process_filter"
                            widget="ace"
                            nolabel="1"
                        />
                        <field
                            name="sampling_process_data"
                            nolabel="1"
                            widget="csv_table"
                            options="{'default_mode': 'table'}"
                        />
                    </page>
                    <page name="sampling_data" string="Sampling Data">
                        <div class="alert alert-info" role="alert">
                            The final result of the sample determination:
                            <code>Key Item</code> (100% examination) and
                            <code>Sample</code> rows.
                            <span
                                attrs="{'invisible': [('method_type', '!=', 'nss')]}"
                            >For Non-Statistical Sampling, choose which
                            candidates become <code>Sample</code> in the
                            "Sampling Process" tab -- unchosen
                            <code>Candidate</code> rows are never listed
                            here, and this table is read-only.</span>
                            <span
                                attrs="{'invisible': [('method_type', '=', 'nss')]}"
                            >Read-only: manually editing an
                            algorithmically-selected sample invalidates its
                            statistical basis.</span>
                        </div>
                        <group name="data_4" colspan="4" col="2">
                            <group
                                name="data_4_1"
                                colspan="1"
                                col="2"
                                string="Examination Plan"
                            >
                                <!-- MUS: Data!S11:S14 are monetary amounts -->
                                <field
                                    name="population_amount"
                                    string="Population Size"
                                    attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                                />
                                <field
                                    name="key_item_amount"
                                    string="Direct Examination"
                                    attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                                />
                                <field
                                    name="sample_amount"
                                    string="Sampling Examination"
                                    attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                                />
                                <field
                                    name="computed_sample_size"
                                    string="Total Plan Sample Examination"
                                    attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                                />
                                <!-- CVS/NSS: Data!S11:S13 are item counts, not amounts -->
                                <field
                                    name="population_count"
                                    string="Population Size"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                                <field
                                    name="key_item_count"
                                    string="Direct Examination"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                                <field
                                    name="computed_sample_size"
                                    string="Sampling Examination"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                                <field name="total_plan_examination" />
                            </group>
                            <group
                                name="data_4_2"
                                colspan="1"
                                col="2"
                                string="Data to Sampling"
                            >
                                <field name="beginning_to_sampling" />
                                <field
                                    name="population_count"
                                    string="Ending to Sampling"
                                />
                                <!-- Data!U13 "Maximal to sampling" reads the
                                     pool-only figure for MUS but the
                                     combined total for CVS/NSS -->
                                <field
                                    name="computed_sample_size"
                                    string="Maximal to Sampling"
                                    attrs="{'invisible': [('method_type', '!=', 'mus')]}"
                                />
                                <field
                                    name="total_plan_examination"
                                    string="Maximal to Sampling"
                                    attrs="{'invisible': [('method_type', '=', 'mus')]}"
                                />
                                <field name="realized_to_sampling" />
                                <field name="sampling_variance" />
                            </group>
                        </group>
                        <field
                            name="sampling_data"
                            nolabel="1"
                            widget="csv_table"
                            options="{'default_mode': 'table'}"
                            readonly="1"
                        />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a916660_action" model="ir.actions.act_window">
        <field name="name">Sample Determination</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_a916660</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_a916660_menu"
        name="Sample Determination"
        parent="ssi_general_audit.menu_rr_substantive_test"
        action="general_audit_ws_a916660_action"
        sequence="4"
        groups="general_audit_ws_a916660_viewer_group"
    />
</odoo>
