<odoo>

    <record id="allocation_template_view_search" model="ir.ui.view">
        <field name="name">allocation_template - search</field>
        <field name="model">allocation_template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="allocation_template_view_tree" model="ir.ui.view">
        <field name="name">allocation_template - tree</field>
        <field name="model">allocation_template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="allocation_template_view_form" model="ir.ui.view">
        <field name="name">allocation_template - form</field>
        <field name="model">allocation_template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="man_hour_allocation" string="Man Hour Allocation">
                        <group>
                            <field name="pe_percentage" string="Pre-Engagement (%)" />
                            <field name="ra_percentage" string="Risk Assessment (%)" />
                            <field name="rr_percentage" string="Risk Response (%)" />
                            <field name="wr_percentage" string="Reporting (%)" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="allocation_template_action" model="ir.actions.act_window">
        <field name="name">Allocation Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">allocation_template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="allocation_template_menu"
        name="Allocation Templates"
        parent="ssi_general_audit.menu_configuration_awp"
        action="allocation_template_action"
        sequence="110"
        groups="allocation_template_group"
    />

</odoo>
