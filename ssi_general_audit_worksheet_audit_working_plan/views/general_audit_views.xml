<odoo>

<record id="general_audit_view_form" model="ir.ui.view">
    <field name="name">general_audit -  form</field>
    <field name="model">general_audit</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="ssi_general_audit.general_audit_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='accountant_id']" position="after">
                <field name="team_allocation_user_ids" widget="many2many_tags_avatar" />
            </xpath>
        </data>
    </field>
</record>

</odoo>
