<odoo>

    <record id="general_audit_ws_cbbbaf4_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_cbbbaf4 form</field>
        <field name="model">general_audit_ws_cbbbaf4</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_cbbbaf4_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_cbbbaf4 tree</field>
        <field name="model">general_audit_ws_cbbbaf4</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_cbbbaf4_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_cbbbaf4 form</field>
        <field name="model">general_audit_ws_cbbbaf4</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="industry_id" />
                    <field name="ownership_type_id" />
                    <field name="budget_plan_status" />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="audit_date" string="Audit Date">
                        <group name="audit_date_1" colspan="4" col="2">
                            <field name="engagement_date" string="Pre-Engagement" />
                            <field
                                name="risk_assessment_date"
                                string="Risk Assessment"
                            />
                            <field name="fieldwork_date" string="Fieldwork" />
                            <field name="pullout_date" string="Pullout" />
                            <field name="reporting_date" string="Reporting" />
                            <field name="effective_days" string="Effective Days" />
                        </group>
                    </page>
                    <page name="manhour" string="Man Hour Allocations">
                        <group name="manhour_1" colspan="4" col="2">
                            <field
                                name="allocation_template_id"
                                string="Allocation Template"
                            />
                            <field
                                name="allocation_total_hour_id"
                                string="Total Hour Template"
                            />
                            <field
                                name="total_manhour_allocation"
                                string="Total Hour"
                                widget="float_time"
                            />
                            <field
                                name="pe_manhour_allocation"
                                string="Pre-Engagement"
                                widget="float_time"
                            />
                            <field
                                name="ra_manhour_allocation"
                                string="Risk Assessment"
                                widget="float_time"
                            />
                            <field
                                name="rr_manhour_allocation"
                                string="Risk Response"
                                widget="float_time"
                            />
                            <field
                                name="wr_manhour_allocation"
                                string="Reporting"
                                widget="float_time"
                            />
                        </group>
                    </page>
                    <page name="team_allocation" string="Team Allocations">
                        <button
                            name="action_refresh_allocation_team"
                            string="Refresh"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                        />
                        <field name="team_allocation_ids">
                            <tree editable="top" create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="team_id" />
                                <field
                                    name="role_id"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field
                                    name="pe_allocation"
                                    widget="float_time"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field
                                    name="ra_allocation"
                                    widget="float_time"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field
                                    name="rr_allocation"
                                    widget="float_time"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field
                                    name="reporting_allocation"
                                    widget="float_time"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field name="total_allocation" widget="float_time" />
                                <field name="state" invisible="1" />
                            </tree>
                        </field>
                        <group name="team_allocation" colspan="4" col="2">
                            <group
                                name="team_allocation_1"
                                string="Total"
                                colspan="1"
                                col="2"
                            >
                            <field
                                    name="total_pe_manhour"
                                    string="Pre-Engagement"
                                    widget="float_time"
                                />
                            <field
                                    name="total_ra_manhour"
                                    string="Risk Assessment"
                                    widget="float_time"
                                />
                            <field
                                    name="total_rr_manhour"
                                    string="Risk Response"
                                    widget="float_time"
                                />
                            <field
                                    name="total_reporting_manhour"
                                    string="Reporting"
                                    widget="float_time"
                                />
                            <field
                                    name="total_manhour"
                                    string="Total"
                                    widget="float_time"
                                />
                            </group>
                            <group
                                name="header_right"
                                string="Difference"
                                colspan="1"
                                col="2"
                            >
                                <field
                                    name="diff_pe_manhour"
                                    string="Pre-Engagement"
                                    widget="float_time"
                                />
                                <field
                                    name="diff_ra_manhour"
                                    string="Risk Assessment"
                                    widget="float_time"
                                />
                                <field
                                    name="diff_rr_manhour"
                                    string="Risk Response"
                                    widget="float_time"
                                />
                                <field
                                    name="diff_reporting_manhour"
                                    string="Reporting"
                                    widget="float_time"
                                />
                                <field
                                    name="dif_total_manhour"
                                    string="Total"
                                    widget="float_time"
                                />
                            </group>
                        </group>
                        <group name="reasonable" colspan="4" cols="2">
                            <field name="reasonable" colspan="4" />
                        </group>
                    </page>
                    <page name="team_competency" string="Team Competency Analysis">
                        <button
                            name="action_refresh_competency_team"
                            string="Refresh"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                        />
                        <group name="team_competency_1" colspan="4" col="2">
                            <field name="need_eqcr" />
                        </group>
                        <field name="team_competency_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="team_id" />
                                <field name="upgrade_attachment_ids" />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="worksheet_id" invisible="1" />
                                        <field name="team_id" invisible="1" />
                                        <field
                                            name="competency_upgrade_ids"
                                            widget="many2many_checkboxes"
                                            force_save="1"
                                        />
                                        <field
                                            name="upgrade_attachment_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="state" invisible="1" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page name="links" string="Links">
                        <group>
                            <group name="link_1" string="Client Acceptance">
                                <field
                                    name="allowed_link_1_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_1"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_1_ids)]"
                                />
                                <field name="link_1_risk" string="Risk" />
                            </group>
                            <group name="link_2" string="Competency">
                                <field
                                    name="allowed_link_2_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_2"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_2_ids)]"
                                />
                                <field name="link_2_risk" string="Risk" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_cbbbaf4_action" model="ir.actions.act_window">
        <field name="name">Audit Working Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_cbbbaf4</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_cbbbaf4_menu"
        name="Audit Working Plan"
        parent="ssi_general_audit.menu_general_audit_working_plan"
        action="general_audit_ws_cbbbaf4_action"
        sequence="1"
        groups="general_audit_ws_cbbbaf4_viewer_group"
    />


</odoo>
