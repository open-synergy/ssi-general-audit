<odoo>

    <record id="allocation_total_hour_view_search" model="ir.ui.view">
        <field name="name">allocation_total_hour - search</field>
        <field name="model">allocation_total_hour</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="allocation_total_hour_view_tree" model="ir.ui.view">
        <field name="name">allocation_total_hour - tree</field>
        <field name="model">allocation_total_hour</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="allocation_total_hour_view_form" model="ir.ui.view">
        <field name="name">allocation_total_hour - form</field>
        <field name="model">allocation_total_hour</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="total_hour" widget="float_time" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="allocation_total_hour_action" model="ir.actions.act_window">
        <field name="name">Allocation Total Hours</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">allocation_total_hour</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="allocation_total_hour_menu"
        name="Allocation Total Hours"
        parent="ssi_general_audit.menu_configuration_acc_computation"
        action="allocation_total_hour_action"
        sequence="90"
        groups="allocation_total_hour_group"
    />

</odoo>
