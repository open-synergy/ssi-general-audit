<odoo>

    <record id="general_audit_ws_d33420f_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_d33420f form</field>
        <field name="model">general_audit_ws_d33420f</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_d33420f_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_d33420f tree</field>
        <field name="model">general_audit_ws_d33420f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d33420f_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_d33420f form</field>
        <field name="model">general_audit_ws_d33420f</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="detail" string="Details">
                        <field name="detail_ids" nolabel="1">
                            <tree>
                                <field name="risk" />
                                <field name="condition" />
                                <field name="criteria" />
                                <field name="cause" />
                                <field name="effect" />
                                <field
                                    name="proposed_adjustment"
                                    string="Recommendation"
                                />
                            </tree>
                            <form>
                                <group name="group_1">
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="risk" />
                                    <field name="condition" />
                                    <field name="criteria" />
                                    <field name="cause" />
                                    <field name="effect" />
                                    <field
                                        name="proposed_adjustment"
                                        string="Recommendation"
                                    />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d33420f_action" model="ir.actions.act_window">
        <field name="name">Control Deficiencies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_d33420f</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_d33420f_menu"
        name="Control Deficiencies"
        parent="ssi_general_audit.menu_general_audit_audit_result_info"
        action="general_audit_ws_d33420f_action"
        sequence="3"
        groups="general_audit_ws_d33420f_viewer_group"
    />
</odoo>
