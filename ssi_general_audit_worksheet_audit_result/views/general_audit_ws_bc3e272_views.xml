<odoo>

    <record id="general_audit_ws_bc3e272_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_bc3e272 form</field>
        <field name="model">general_audit_ws_bc3e272</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_bc3e272_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_bc3e272 tree</field>
        <field name="model">general_audit_ws_bc3e272</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_bc3e272_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_bc3e272 form</field>
        <field name="model">general_audit_ws_bc3e272</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="detail" string="Details">
                        <button
                            name="action_populate"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <separator string="Findings That Influence Opinion" />
                        <field name="influence_ids" nolabel="1">
                            <tree create="false" delete="false">
                                <field name="condition" />
                                <field name="risk" />
                                <field name="result" />
                                <field name="follow_up" />
                            </tree>
                            <form>
                                <group name="group_1">
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="condition" />
                                    <field name="risk" />
                                    <field name="result" />
                                    <field name="follow_up" />
                                </group>
                            </form>
                        </field>
                        <separator string="Control Deficiencies" />
                        <field name="control_ids" nolabel="1">
                            <tree create="false" delete="false">
                                <field name="condition" />
                                <field name="risk" />
                                <field name="result" />
                                <field name="follow_up" />
                            </tree>
                            <form>
                                <group name="group_1">
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="condition" />
                                    <field name="risk" />
                                    <field name="result" />
                                    <field name="follow_up" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_bc3e272_action" model="ir.actions.act_window">
        <field name="name">Audit Result Discussion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_bc3e272</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_bc3e272_menu"
        name="Audit Result Discussion"
        parent="ssi_general_audit.menu_general_audit_audit_result"
        action="general_audit_ws_bc3e272_action"
        sequence="2"
        groups="general_audit_ws_bc3e272_viewer_group"
    />
</odoo>
