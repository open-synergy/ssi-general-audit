<odoo>

    <record id="general_audit_ws_ab19fd4_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_ab19fd4 form</field>
        <field name="model">general_audit_ws_ab19fd4</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_ab19fd4_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_ab19fd4 tree</field>
        <field name="model">general_audit_ws_ab19fd4</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ab19fd4_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_ab19fd4 form</field>
        <field name="model">general_audit_ws_ab19fd4</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="link_1" string="Details">
                        <button
                            name="action_recompute"
                            string="Reload"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <separator string="Findings That Influence Opinion" />
                        <field name="link_1_ids" nolabel="1">
                            <tree>
                                <field name="risk" />
                                <field name="condition" />
                                <field name="criteria" />
                                <field name="cause" />
                                <field name="effect" />
                                <field name="proposed_adjustment" />
                            </tree>
                        </field>
                        <separator string="Control Deficiencies" />
                        <field name="link_2_ids" nolabel="1">
                            <tree>
                                <field name="risk" />
                                <field name="condition" />
                                <field name="criteria" />
                                <field name="cause" />
                                <field name="effect" />
                                <field
                                    name="proposed_adjustment"
                                    string="Recommendation"
                                />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ab19fd4_action" model="ir.actions.act_window">
        <field name="name">Audit Result Formulation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_ab19fd4</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_ab19fd4_menu"
        name="Audit Result Formulation"
        parent="ssi_general_audit.menu_general_audit_audit_result_info"
        action="general_audit_ws_ab19fd4_action"
        sequence="1"
        groups="general_audit_ws_ab19fd4_viewer_group"
    />
</odoo>
