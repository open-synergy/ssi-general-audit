<odoo>

    <record id="general_audit_ws_c16abd7_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_c16abd7 form</field>
        <field name="model">general_audit_ws_c16abd7</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_c16abd7_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_c16abd7 tree</field>
        <field name="model">general_audit_ws_c16abd7</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c16abd7_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_c16abd7 form</field>
        <field name="model">general_audit_ws_c16abd7</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="inherent_risk" string="Inherent Risks">
                        <group
                            name="inherit_risk_1"
                            string="Impact Factor"
                            colspan="4"
                            col="2"
                        >
                            <group name="inherent_risk_1_1" colspan="1" col="2">
                                <field
                                    name="expert_impacted_account_type_ids"
                                    string="Expert Use"
                                    widget="many2many_tags"
                                />
                                <field
                                    name="previous_other_information_impacted_account_type_ids"
                                    string="Previous Other Information"
                                    widget="many2many_tags"
                                />
                                <field
                                    name="regulation_impacted_account_type_ids"
                                    string="Regulation"
                                    widget="many2many_tags"
                                />
                            </group>
                            <group name="inherent_risk_1_2" colspan="1" col="2">
                                <field
                                    name="previous_audit_information_impacted_account_type_ids"
                                    string="Previous Audit Information"
                                    widget="many2many_tags"
                                />
                                <field
                                    name="other_information_impacted_account_type_ids"
                                    string="Other Information"
                                    widget="many2many_tags"
                                />
                                <field
                                    name="preparation_of_financial_statements_impacted_account_type_ids"
                                    string="Preparation of Financial Statements"
                                    widget="many2many_tags"
                                />
                            </group>
                        </group>
                        <group
                            name="inherent_risk_2"
                            string="Inherent Risk"
                            colspan="4"
                            col="2"
                        >
                            <field name="risk_material_missstatement" />
                            <field name="auditor_respons" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c16abd7_action" model="ir.actions.act_window">
        <field name="name">Inherent Risk - Financial Statement Level</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_c16abd7</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_c16abd7_menu"
        name="Inherent Risk - Financial Statement Level"
        parent="ssi_general_audit.menu_general_audit_inherent_risk"
        action="general_audit_ws_c16abd7_action"
        sequence="2"
        groups="general_audit_ws_c16abd7_viewer_group"
    />


</odoo>
