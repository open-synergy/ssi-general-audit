<odoo>
    <record id="general_audit_ws_a3c9d2e_internal_user_rule" model="ir.rule">
        <field
            name="name"
        >Analytical Procedures - Cycle (a3c9d2e) - Internal Users</field>
        <field name="model_id" ref="model_general_audit_ws_a3c9d2e" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">['|','|','|',
      ('user_id','=',user.id),
      ('reviewer_id','=',user.id),
      ('general_audit_id.user_id','=',user.id),
      ('general_audit_id.reviewer_id','=',user.id)]</field>
        <field name="perm_unlink" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
    </record>
    <record id="general_audit_ws_a3c9d2e_internal_user_team_rule" model="ir.rule">
        <field
            name="name"
        >Analytical Procedures - Cycle (a3c9d2e) - Internal Users - Audit Team</field>
        <field name="model_id" ref="model_general_audit_ws_a3c9d2e" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field
            name="domain_force"
        >[('general_audit_id.team_allocation_user_ids', 'in', [user.id])]</field>
        <field name="perm_unlink" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
    </record>
    <record id="general_audit_ws_a3c9d2e_company_rule" model="ir.rule">
        <field
            name="name"
        >Analytical Procedures - Cycle (a3c9d2e) - Responsible to company data</field>
        <field name="model_id" ref="model_general_audit_ws_a3c9d2e" />
        <field
            name="groups"
            eval="[(4, ref('general_audit_ws_a3c9d2e_company_group'))]"
        />
        <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        <field name="perm_unlink" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
    </record>
    <record id="general_audit_ws_a3c9d2e_companies_rule" model="ir.rule">
        <field
            name="name"
        >Analytical Procedures - Cycle (a3c9d2e) - Responsible to company and all child companies data</field>
        <field name="model_id" ref="model_general_audit_ws_a3c9d2e" />
        <field
            name="groups"
            eval="[(4, ref('general_audit_ws_a3c9d2e_company_child_group'))]"
        />
        <field name="domain_force">[('company_id','in',user.company_ids.ids)]</field>
        <field name="perm_unlink" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
    </record>
    <record id="general_audit_ws_a3c9d2e_all_rule" model="ir.rule">
        <field name="name">Analytical Procedures - Cycle (a3c9d2e) - All</field>
        <field name="model_id" ref="model_general_audit_ws_a3c9d2e" />
        <field name="groups" eval="[(4, ref('general_audit_ws_a3c9d2e_all_group'))]" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_unlink" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
    </record>
</odoo>
