<odoo>

    <record id="general_audit_ws_805d4d5_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_805d4d5 form</field>
        <field name="model">general_audit_ws_805d4d5</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_805d4d5_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_805d4d5 tree</field>
        <field name="model">general_audit_ws_805d4d5</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_805d4d5_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_805d4d5 form</field>
        <field name="model">general_audit_ws_805d4d5</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">

                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page
                        string="SIMPLIFIED"
                        name="satu"
                        attrs="{'invisible': [('pmpj_simplified', '!=', True)]}"
                    >
                        <separator
                            string="A. Basic Information of the Customer"
                            colspan="4"
                        />
                        <group>
                            <group colspan="4" col="4">
                                <field name="entity_partner_id" />
                                <field name="entity_type_id" />
                                <field name="npwp" string="NPWP" />
                                <field
                                    name="field_industry_id"
                                    string="Business Field"
                                />
                                <field name="fax" />
                                <field name="phone" />
                                <field
                                    name="sk_number"
                                    placeholder="Decree of Ratification Number"
                                />
                                <field
                                    name="sk_date"
                                    string="Date"
                                    placeholder="Decree of Ratification Date"
                                />
                                <field
                                    name="bussines_license"
                                    placeholder="Bussines License"
                                />
                                <field
                                    name="business_license_date"
                                    string="Date"
                                    placeholder="Bussiness License Date"
                                />
                                <field name="legal_address" />
                                <field name="location_address" />
                                <field
                                    name="deed_number"
                                    placeholder="Deed of Establishment or Latest Amendment Number"
                                />
                                <field
                                    name="deed_date"
                                    string="Date"
                                    placeholder="Deed of Establishment or Latest Amendment Date"
                                />
                            </group>
                        </group>
                        <separator
                            string="B. Information on the Services Provided"
                            colspan="4"
                        />
                        <group>
                            <group colspan="4" col="4">
                                <field name="partner_accountant_id" />
                                <field name="service" force_save="1" />
                            </group>
                        </group>
                        <separator
                            string="C. Name, Position, and Identity of the Management Authorized"
                            colspan="4"
                        />
                        <group>
                            <field name="management_ids" nolabel="1">
                                <tree editable="top">
                                    <field name="name" />
                                    <field name="position" />
                                    <field name="identity_no" />
                                    <field name="identity_type" />
                                </tree>
                            </field>
                        </group>
                    </page>
                    <page
                        string="INTERMEDIATE"
                        name="dua"
                        attrs="{'invisible': [('pmpj_intermediate', '!=', True)]}"
                    >
                        <separator
                            string="D. Information on the Entity’s Assets"
                            colspan="4"
                        />
                        <group>
                            <group colspan="4" col="4">
                                <field name="source_fund" />
                                <field
                                    name="field_industry_2_id"
                                    string="Business Field"
                                />
                                <field name="annual_income" />
                                <field name="trans_purpose" />
                            </group>
                        </group>
                        <separator string="E. Beneficial Owner" colspan="4" />
                        <group>
                            <group colspan="4" col="4">
                                <field name="owner_name" string="Full Name" />
                                <field name="owner_alias" string="Alias (if any)" />
                                <field
                                    name="owner_identity_no"
                                    string="Identity Number"
                                />
                                <field
                                    name="owner_identity_type"
                                    string="Type of Identity"
                                />
                                <field name="owner_birthday" string="Date of Birth" />
                                <field
                                    name="owner_place_of_birth"
                                    string="Place of Birth"
                                />
                                <field
                                    name="owner_country_id"
                                    string="Nationality (Country)"
                                />
                                <field name="owner_npwp" string="NPWP" />
                                <field
                                    name="owner_residential_address"
                                    string="Residential Address"
                                />
                                <field name="owner_origin_address" />
                                <field
                                    name="owner_relationship"
                                    string="Relationship"
                                />
                                <field
                                    name="owner_verification"
                                    string="Identity Verification Statement"
                                />
                            </group>
                        </group>
                        <separator
                            string="F. Information on Entity’s Proxy"
                            colspan="4"
                        />
                        <group>
                            <group colspan="4" col="4">
                                <field name="proxy_name" string="Full Name" />
                                <field name="proxy_alias" string="Alias (if any)" />
                                <field name="proxy_number" />
                                <field name="proxy_date" />
                                <field
                                    name="proxy_identity_no"
                                    string="Identity Number"
                                />
                                <field
                                    name="proxy_identity_type"
                                    string="Type of Identity"
                                />
                                <field name="proxy_birthday" string="Date of Birth" />
                                <field
                                    name="proxy_place_of_birth"
                                    string="Place of Birth"
                                />
                                <field name="proxy_signature" />
                                <field
                                    name="proxy_country_id"
                                    string="Nationality (Country)"
                                />
                                <field
                                    name="proxy_residential_address"
                                    string="Residential Address"
                                />
                                <field
                                    name="proxy_relationship"
                                    string="Relationship"
                                />
                                <field
                                    name="proxy_verification"
                                    string="Identity Verification Statement"
                                />
                            </group>
                        </group>
                    </page>
                    <page
                        string="ENHANCED"
                        name="tiga"
                        attrs="{'invisible': [('pmpj_enhanced', '!=', True)]}"
                    >
                        <group>
                            <group colspan="4" col="4">
                                <field name="identification_count" />
                                <field name="identification_statement" />
                            </group>
                        </group>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                    <page name="links" string="Links">
                        <group>
                            <group name="link_1" string="Money laundring issues">
                                <field
                                    name="allowed_link_1_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_1"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_1_ids)]"
                                />
                                <field name="link_1_pmpj" string="PMPJ" />
                                <field name="pmpj_simplified" />
                                <field name="pmpj_intermediate" />
                                <field name="pmpj_enhanced" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_805d4d5_action" model="ir.actions.act_window">
        <field name="name">Know Your Customer Principles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_805d4d5</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_805d4d5_menu"
        name="Know Your Customer Principles"
        parent="general_audit_ws_f5e7049_root"
        action="general_audit_ws_805d4d5_action"
        sequence="3"
        groups="general_audit_ws_805d4d5_viewer_group"
    />
</odoo>
