<odoo>

    <record id="general_audit_ws_f5e7049_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f5e7049 form</field>
        <field name="model">general_audit_ws_f5e7049</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_f5e7049_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f5e7049 tree</field>
        <field name="model">general_audit_ws_f5e7049</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f5e7049_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f5e7049 form</field>
        <field name="model">general_audit_ws_f5e7049</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="risk" />
                </xpath>
                <xpath expr="//page[@name='note']" position="after">
                    <page name="links" string="Links">
                        <group>
                            <field
                                name="allowed_link_1_ids"
                                widget="many2many_tags"
                                invisible="1"
                            />
                            <field
                                name="link_1"
                                domain="[('id', '=', allowed_link_1_ids)]"
                            />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f5e7049_action" model="ir.actions.act_window">
        <field name="name">Management Integrity</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_f5e7049</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_f5e7049_root"
        name="Management Integrity"
        parent="ssi_general_audit.menu_general_audit_client_acceptance"
        sequence="3"
    />

    <menuitem
        id="general_audit_ws_f5e7049_menu"
        name="Management Integrity"
        parent="general_audit_ws_f5e7049_root"
        action="general_audit_ws_f5e7049_action"
        sequence="1"
        groups="general_audit_ws_f5e7049_viewer_group"
    />
</odoo>
