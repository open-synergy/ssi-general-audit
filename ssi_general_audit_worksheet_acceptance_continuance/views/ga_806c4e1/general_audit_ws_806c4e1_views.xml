<odoo>

    <record id="general_audit_ws_806c4e1_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_806c4e1 form</field>
        <field name="model">general_audit_ws_806c4e1</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_806c4e1_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_806c4e1 tree</field>
        <field name="model">general_audit_ws_806c4e1</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_806c4e1_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_806c4e1 form</field>
        <field name="model">general_audit_ws_806c4e1</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field name="risk" />
                    <field name="client_relationship" />
                </xpath>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="industry_id" />
                    <field name="ownership_type_id" />
                    <field name="public_offering" />
                    <field name="financial_accounting_standard_id" />
                    <field name="engagemet" />
                    <field name="establishment_state" />
                    <field name="financial_statement" />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="links" string="Links">
                        <group>
                            <group
                                name="link_1"
                                string="Previous Financial Reporting Issues"
                            >
                                <field
                                    name="allowed_link_1_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_1"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_1_ids)]"
                                />
                                <field name="link_1_risk" string="Risk" />
                            </group>
                            <group name="link_2" string="Management Integrity">
                                <field
                                    name="allowed_link_2_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_2"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_2_ids)]"
                                />
                                <field name="link_2_risk" string="Risk" />
                            </group>
                            <group
                                name="link_3"
                                string="Competency, Availability, and Independency of Assignment Team"
                            >
                                <field
                                    name="allowed_link_3_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_3"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_3_ids)]"
                                />
                                <field name="link_3_risk" string="Risk" />
                            </group>
                            <group
                                name="link_4"
                                string="Communication With Previous Auditor"
                            >
                                <field
                                    name="allowed_link_4_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field
                                    name="link_4"
                                    string="# Worksheet"
                                    domain="[('id', '=', allowed_link_4_ids)]"
                                />
                                <field name="link_4_risk" string="Risk" />
                            </group>
                        </group>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_806c4e1_action" model="ir.actions.act_window">
        <field
            name="name"
        >Acceptance and Continuance of Client Relationships Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_806c4e1</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_806c4e1_menu"
        name="Acceptance and Continuance of Client Relationships Analysis"
        parent="ssi_general_audit.menu_general_audit_client_acceptance"
        action="general_audit_ws_806c4e1_action"
        sequence="1"
        groups="general_audit_ws_806c4e1_viewer_group"
    />
</odoo>
