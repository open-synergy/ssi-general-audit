<odoo>

    <record id="general_audit_ws_0427d28_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_0427d28 form</field>
        <field name="model">general_audit_ws_0427d28</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_0427d28_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_0427d28 tree</field>
        <field name="model">general_audit_ws_0427d28</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_0427d28_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_0427d28 form</field>
        <field name="model">general_audit_ws_0427d28</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="engagemet" />
                    <field name="engagemet_ok" invisible="1" />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page
                        name="checklist"
                        string="Checklist"
                        attrs="{'invisible': [('engagemet_ok', '=', True)]}"
                    >
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree editable="top">
                                <field name="sequence" widget="handle" />
                                <field name="item_id" />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="item_id" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field name="risk" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_0427d28_action" model="ir.actions.act_window">
        <field name="name">Communication With Previous Auditor</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_0427d28</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_0427d28_menu"
        name="Communication With Previous Auditor"
        parent="ssi_general_audit.menu_general_audit_client_acceptance"
        action="general_audit_ws_0427d28_action"
        sequence="5"
        groups="general_audit_ws_0427d28_viewer_group"
    />
</odoo>
