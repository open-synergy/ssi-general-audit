<odoo>

    <record id="general_audit_ws_b9d8a5c_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c form</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c tree</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c form</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="risk" />
                </xpath>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="personnel_list" string="List of KAP Personnel">
                        <field name="personnel_ids">
                            <tree editable="top">
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="job_id" />
                                <field
                                    name="competency_attachment_ids"
                                    widget="many2many_binary"
                                />
                                <field
                                    name="time_availability_attachment_ids"
                                    widget="many2many_binary"
                                />
                            </tree>
                        </field>
                    </page>
                    <page name="competency_analysis_list" string="Competency Analysis">
                        <field name="competency_analysis_ids">
                            <tree editable="top">
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field name="year_experience" />
                                <field
                                    name="analysis_item_ids"
                                    widget="many2many_tags"
                                />
                            </tree>
                        </field>
                    </page>
                    <page
                        name="availability_analysis_list"
                        string="Availability Analysis"
                    >
                        <field name="availability_analysis_ids">
                            <tree editable="top">
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field
                                    name="analysis_item_ids"
                                    widget="many2many_tags"
                                />
                            </tree>
                        </field>
                    </page>
                    <page
                        name="independency_analysis_list"
                        string="Independency Analysis"
                    >
                        <field name="independency_analysis_ids">
                            <tree editable="top">
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field
                                    name="analysis_item_ids"
                                    widget="many2many_tags"
                                />
                            </tree>
                        </field>
                    </page>
                    <page name="summary" string="Summary">
                        <field name="summary_ids">
                            <tree editable="top">
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="compentency_result" />
                                <field name="availability_result" />
                                <field name="independency_result" />
                                <field name="initials" />
                                <field name="team_role_id" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_action" model="ir.actions.act_window">
        <field
            name="name"
        >Competency, Availability and Independency Of Assignment Team</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b9d8a5c</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b9d8a5c_menu"
        name="Competency, Availability and Independency Of Assignment Team"
        parent="ssi_general_audit.menu_general_audit_client_acceptance"
        action="general_audit_ws_b9d8a5c_action"
        sequence="4"
        groups="general_audit_ws_b9d8a5c_viewer_group"
    />
</odoo>
