<odoo>

    <record id="general_audit_ws_b9d8a5c_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c form</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c tree</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b9d8a5c form</field>
        <field name="model">general_audit_ws_b9d8a5c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field name="risk" />
                </xpath>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="personnel_list" string="List of KAP Personnel">
                        <button
                            name="action_populate_personnel"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                        />
                        <field
                            name="personnel_ids"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        >
                            <tree editable="top">
                                <field name="sequence" widget="handle" />
                                <field name="worksheet_id" invisible="1" />
                                <field
                                    name="employee_id"
                                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                                />
                                <field
                                    name="job_id"
                                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                                />
                                <field name="year_experience" />
                                <field
                                    name="competency_attachment_ids"
                                    widget="many2many_tags"
                                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                                />
                                <field
                                    name="time_availability_attachment_ids"
                                    widget="many2many_tags"
                                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                                />
                                <field
                                    name="proposed"
                                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                                />
                                <field name="state" invisible="1" />
                            </tree>
                        </field>
                    </page>
                    <page
                        string="Competency Analysis"
                        name="competency_analysis_list"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    >
                        <field name="competency_analysis_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <sheet>
                                    <div
                                        class="o_form_label"
                                    >Select the competencies that the auditor has:</div>
                                    <group>
                                        <field name="employee_id" invisible="1" />
                                        <field
                                            name="analysis_item_ids"
                                            widget="many2many_checkboxes"
                                        />
                                        <field
                                            name="result"
                                            attrs="{'required': [('state', '=', 'open')]}"
                                        />
                                        <field name="state" invisible="1" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page
                        name="availability_analysis_list"
                        string="Availability Analysis"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    >
                        <field
                            name="availability_analysis_ids"
                            create="false"
                            delete="false"
                        >
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <sheet>
                                    <div
                                        class="o_form_label"
                                    >Select the auditor's available time conditions:</div>
                                    <group>
                                        <field name="employee_id" invisible="1" />
                                        <field
                                            name="analysis_item_ids"
                                            widget="many2many_checkboxes"
                                        />
                                        <field
                                            name="result"
                                            attrs="{'required': [('state', '=', 'open')]}"
                                        />
                                        <field name="state" invisible="1" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page
                        name="independency_analysis_list"
                        string="Independency Analysis"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    >
                        <field name="independency_analysis_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" />
                                <field name="result" />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <sheet>
                                    <div
                                        class="o_form_label"
                                    >Select auditor conditions related to independence:</div>
                                    <group>
                                        <field name="employee_id" invisible="1" />
                                        <field
                                            name="analysis_item_ids"
                                            widget="many2many_checkboxes"
                                        />
                                        <field
                                            name="result"
                                            attrs="{'required': [('state', '=', 'open')]}"
                                        />
                                        <field name="state" invisible="1" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page
                        string="Summary"
                        name="summary"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    >
                        <field name="summary_ids" create="false" delete="false">
                            <tree editable="top" create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="worksheet_id" invisible="1" />
                                <field name="employee_id" readonly="1" force_save="1" />
                                <field name="initials" />
                                <field name="compentency_result" />
                                <field name="availability_result" />
                                <field name="independency_result" />
                                <field
                                    name="select_team"
                                    attrs="{'required': [('state', '=', 'open')]}"
                                />
                                <field
                                    name="team_role_id"
                                    attrs="{'required': [('select_team', '=', 'yes')]}"
                                />
                                <field name="state" invisible="1" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b9d8a5c_action" model="ir.actions.act_window">
        <field
            name="name"
        >Competency, Availability and Independency Of Assignment Team</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b9d8a5c</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b9d8a5c_menu"
        name="Competency, Availability and Independency Of Assignment Team"
        parent="ssi_general_audit.menu_general_audit_client_acceptance"
        action="general_audit_ws_b9d8a5c_action"
        sequence="4"
        groups="general_audit_ws_b9d8a5c_viewer_group"
    />
</odoo>
