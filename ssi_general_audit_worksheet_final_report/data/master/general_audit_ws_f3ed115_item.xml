<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="general_audit_ws_f3ed115_item_1" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Qualitative Aspects of Accounting Practices: Significant accounting policies, accounting estimates (including estimation uncertainty), and financial statement disclosures.</field>
        <field name="sequence" eval="10" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_1" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_2" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Significant Difficulties Encountered: Severe delays in management providing information, brief timelines, extensive unexpected effort, or restriction of access.</field>
        <field name="sequence" eval="20" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_1" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_3" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Significant Matters Discussed with Management: Business conditions affecting the entity, management consultations with other accountants, or discussions on initial engagement terms.</field>
        <field name="sequence" eval="30" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_1" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_4" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Written Representations Requested: Review of all formal representations requested by the auditor from management.</field>
        <field name="sequence" eval="40" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_1" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_5" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Other Significant Matters: Material matters arising that are directly relevant to the financial reporting oversight process.</field>
        <field name="sequence" eval="50" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_1" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_6" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Independence Statement: Confirm in writing that the engagement team, network firms, and the audit firm have complied with relevant ethical requirements regarding independence.</field>
        <field name="sequence" eval="60" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_2" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_7" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Fees Disclosed by Category: Full disclosure of all fees charged by the firm and network firms for audit, assurance, tax, and non-audit services.</field>
        <field name="sequence" eval="70" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_2" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_8" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Safeguards and Threats Identified: Detailed threats to independence identified (e.g., self-review, advocacy, familiarity) and the corresponding safeguards applied.</field>
        <field name="sequence" eval="80" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_2" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_9" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Uncorrected Misstatements: A list of all uncorrected misstatements accumulated during the audit and their impact on the audit opinion.</field>
        <field name="sequence" eval="90" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_3" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_10" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Significant Deficiencies in Internal Control: Written communication of severe control gaps identified during the audit to TCWG.</field>
        <field name="sequence" eval="100" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_3" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_11" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Actual or Suspected Non-Compliance (NOCLAR): Reporting intentional or unintentional acts of omission or commission contrary to laws and regulations.</field>
        <field name="sequence" eval="110" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_3" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_12" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Identified or Suspected Fraud: Fraud involving management, employees with internal control roles, or others where it causes a material misstatement.</field>
        <field name="sequence" eval="120" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_3" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_13" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Key Audit Matters (KAMs): Matters that required significant auditor attention, including high-risk areas and complex judgments.</field>
        <field name="sequence" eval="130" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_4" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_14" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Expected Modifications to the Audit Report: Any proposed modified opinions (qualified, adverse, or disclaimer) or Emphasis of Matter paragraphs.</field>
        <field name="sequence" eval="140" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_4" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
    <record id="general_audit_ws_f3ed115_item_15" model="general_audit_ws_f3ed115.item">
        <field name="code">/</field>
        <field
            name="name"
        >Going Concern Events/Conditions: Material uncertainties related to events or conditions that cast significant doubt on the entity's ability to continue as a going concern.</field>
        <field name="sequence" eval="150" />
        <field name="category_id" ref="general_audit_ws_f3ed115_category_4" />
        <field name="option_set_id" ref="ssi_general_audit.checklist_option_set_1" />
    </record>
</odoo>
