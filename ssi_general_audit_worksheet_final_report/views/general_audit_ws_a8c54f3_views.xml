<odoo>

    <record id="general_audit_ws_a8c54f3_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a8c54f3 form</field>
        <field name="model">general_audit_ws_a8c54f3</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_a8c54f3_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a8c54f3 tree</field>
        <field name="model">general_audit_ws_a8c54f3</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a8c54f3_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a8c54f3 form</field>
        <field name="model">general_audit_ws_a8c54f3</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field
                        name="proposed_audit_opinion_id"
                        attrs="{'readonly': [('state', '!=', 'open')]}"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="links" string="Conclusions">
                        <button
                            name="action_reload_links"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="conclusion_line_ids" nolabel="1">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="type_id" />
                                <field name="worksheet_count" />
                                <field name="worksheet_ids" widget="many2many_tags" />
                                <field name="locked_ok" invisible="1" />
                                <field
                                    name="conclusion"
                                    attrs="{'readonly': [('locked_ok', '=', True)]}"
                                />
                            </tree>
                            <form>
                                <group name="conclusion_1" colspan="4" col="2">
                                    <field name="type_id" />
                                    <field name="worksheet_count" />
                                    <field
                                        name="worksheet_ids"
                                        widget="many2many_tags"
                                    />
                                    <field name="locked_ok" invisible="1" />
                                    <field
                                        name="conclusion"
                                        attrs="{'readonly': [('locked_ok', '=', True)]}"
                                    />
                                </group>
                            </form>
                        </field>
                        <!-- Empty anchor kept for the inherit view of
                             ssi_general_audit_worksheet_review, which
                             still adds its own link groups after it. -->
                        <group name="activity_41" />
                    </page>
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="category_id" optional="hide" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="item_id" invisible="1" />
                                        <field name="category_id" />
                                        <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a8c54f3_action" model="ir.actions.act_window">
        <field name="name">Audit Final Memorandum</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_a8c54f3</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_a8c54f3_menu"
        name="Audit Final Memorandum"
        parent="ssi_general_audit.menu_general_audit_final_report"
        action="general_audit_ws_a8c54f3_action"
        sequence="1"
        groups="general_audit_ws_a8c54f3_viewer_group"
    />
</odoo>
