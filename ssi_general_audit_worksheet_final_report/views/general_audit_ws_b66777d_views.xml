<odoo>

    <record id="general_audit_ws_b66777d_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b66777d form</field>
        <field name="model">general_audit_ws_b66777d</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b66777d_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b66777d tree</field>
        <field name="model">general_audit_ws_b66777d</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b66777d_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b66777d form</field>
        <field name="model">general_audit_ws_b66777d</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field name="lai_number" />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="details" string="Details">
                        <button
                            name="action_populate_detail"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="detail_ids" nolabel="1">
                            <tree create="false" delete="false" editable="false">
                                <field name="property_id" readonly="1" />
                                <field name="value" readonly="1" />
                            </tree>
                            <form>
                                <group>
                                    <field name="property_id" readonly="1" />
                                    <field name="python_code" readonly="1" />
                                    <field name="value" readonly="1" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='details']" position="after">
                    <page name="final_opinion" string="Final Audit Opinion">
                        <button
                            name="action_populate_final_opinion"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <label for="opinion" />
                        <field name="opinion" widget="html" nolabel="1" />
                        <label for="basis_for_opinion" />
                        <field name="basis_for_opinion" widget="html" nolabel="1" />
                        <label for="key_audit_matters" />
                        <field name="key_audit_matters" widget="html" nolabel="1" />
                        <label for="other_information" />
                        <field name="other_information" widget="html" nolabel="1" />
                        <label for="responsibilities_of_management" />
                        <field
                            name="responsibilities_of_management"
                            widget="html"
                            nolabel="1"
                        />
                        <label for="auditor_responsibilities" />
                        <field
                            name="auditor_responsibilities"
                            widget="html"
                            nolabel="1"
                        />
                        <label for="other_legal_regulatory" />
                        <field
                            name="other_legal_regulatory"
                            widget="html"
                            nolabel="1"
                        />
                        <label for="emphasis_of_matter" />
                        <field name="emphasis_of_matter" widget="html" nolabel="1" />
                        <label for="other_matter" />
                        <field name="other_matter" widget="html" nolabel="1" />
                    </page>
                </xpath>
                <xpath expr="//page[@name='final_opinion']" position="after">
                    <page name="final_team_allocation" string="Final Team Allocations">
                        <button
                            name="action_populate_team_allocation"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="team_allocation_ids" nolabel="1">
                            <tree create="false" delete="false" editable="false">
                                <field name="team_id" readonly="1" />
                                <field name="total_preparation_time" readonly="1" />
                                <field name="total_review_time" readonly="1" />
                                <field name="total_allocation" readonly="1" />
                                <field name="awp_total_allocation" readonly="1" />
                                <field name="diff_allocation" readonly="1" />
                            </tree>
                            <form>
                                <group>
                                    <field name="team_id" readonly="1" />
                                    <field name="total_preparation_time" readonly="1" />
                                    <field name="total_review_time" readonly="1" />
                                    <field name="total_allocation" readonly="1" />
                                    <field name="awp_total_allocation" readonly="1" />
                                    <field name="diff_allocation" readonly="1" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b66777d_action" model="ir.actions.act_window">
        <field name="name">Independen Auditor Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b66777d</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b66777d_menu"
        name="Independen Auditor Report"
        parent="ssi_general_audit.menu_general_audit_final_report"
        action="general_audit_ws_b66777d_action"
        sequence="4"
        groups="general_audit_ws_b66777d_viewer_group"
    />
</odoo>
