<odoo>

    <record id="general_audit_ws_f9f3299_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f9f3299 form</field>
        <field name="model">general_audit_ws_f9f3299</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_f9f3299_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f9f3299 tree</field>
        <field name="model">general_audit_ws_f9f3299</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                    <field name="balance_type" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f9f3299_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f9f3299 form</field>
        <field name="model">general_audit_ws_f9f3299</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='type_id']" position="after">
                    <field
                        name="allowed_account_type_ids"
                        invisible="1"
                        widget="many2many_tags"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="accounts" string="Accounts">
                        <group name="account_1" colspan="4" col="2">
                            <field name="balance_type" />
                        </group>
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft','open'])]}"
                        />
                        <field name="detail_ids">
                            <tree
                                editable="bottom"
                                create="false"
                                delete="false"
                                edit="true"
                            >
                                <field name="account_id" />
                                <field name="detail_id" invisible="1" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" />
                                <field name="supporting_schedule" />
                                <field name="adjustment_ids" widget="many2many_tags" />
                                <field name="adjustment_dr" />
                                <field name="adjustment_cr" />
                                <field name="adjusted_balance" />
                                <field name="previous_balance" />
                                <field name="diff" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="detail_id" invisible="1" />
                                        <field name="account_id" />
                                        <field name="currency_id" invisible="1" />
                                        <field name="current_balance" />
                                        <field name="supporting_schedule" />
                                        <field
                                            name="adjustment_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="adjustment_dr" />
                                        <field name="adjustment_cr" />
                                        <field name="adjusted_balance" />
                                        <field name="previous_balance" />
                                        <field name="diff" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f9f3299_action" model="ir.actions.act_window">
        <field name="name">Lead Schedule - Account</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_f9f3299</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_f9f3299_menu"
        name="Lead Schedule - Account"
        parent="ssi_general_audit.menu_general_audit_lead_schedule"
        action="general_audit_ws_f9f3299_action"
        sequence="1"
        groups="general_audit_ws_f9f3299_viewer_group"
    />
</odoo>
