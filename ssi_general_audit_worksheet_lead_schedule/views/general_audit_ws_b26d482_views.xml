<odoo>

    <record id="general_audit_ws_b26d482_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b26d482 form</field>
        <field name="model">general_audit_ws_b26d482</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b26d482_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b26d482 tree</field>
        <field name="model">general_audit_ws_b26d482</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="balance_type" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b26d482_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b26d482 form</field>
        <field name="model">general_audit_ws_b26d482</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page string="Details">
                        <group name="detail_1" colspan="4" col="2">
                            <field name="balance_type" />
                        </group>
                        <button
                            name="action_load_detail"
                            type="object"
                            string="Accounts"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="detail_ids">
                            <tree editable="bottom" create="true" delete="true">
                                <field name="detail_id" invisible="1" />
                                <field name="account_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" optional="show" />
                                <field
                                    name="ws_f9f3299_id"
                                    string="Lead Schedule"
                                    optional="hide"
                                />
                                <field name="adjustment_dr" optional="show" />
                                <field name="adjustment_cr" optional="show" />
                                <field name="adjusted_balance" optional="show" />
                                <field name="current_profit" optional="show" />
                                <field name="oci" optional="show" />
                                <field name="balance_sheet" optional="show" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="detail_id" invisible="1" />
                                        <field name="account_id" />
                                        <field name="currency_id" invisible="1" />
                                        <field name="current_balance" />
                                        <field name="ws_f9f3299_id" />
                                        <field name="adjustment_dr" />
                                        <field name="adjustment_cr" />
                                        <field name="adjusted_balance" />
                                        <field name="current_profit" />
                                        <field name="oci" />
                                        <field name="balance_sheet" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                        <group name="detail_totals" string="Total" colspan="4" col="2">
                            <field name="net_current_balance" />
                            <field name="net_adjusted_balance" />
                            <field name="net_current_profit" />
                            <field name="net_oci" />
                            <field name="total_balance_sheet" string="Balance Sheet" />
                            <field name="total_closing_unallocated" invisible="1" />
                        </group>
                    </page>
                    <page string="Closing">
                        <button
                            name="action_generate_closing"
                            type="object"
                            string="Generate"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="closing_line_ids">
                            <tree>
                                <field name="account_id" width="240px" />
                                <field name="account_type_id" width="200px" />
                                <field name="partner_id" width="200px" />
                                <field name="name" />
                                <field name="currency_id" invisible="1" />
                                <field name="debit" sum="Total Debit" width="170px" />
                                <field name="credit" sum="Total Credit" width="170px" />
                            </tree>
                            <form>
                                <group name="closing_line_form" colspan="4" col="2">
                                    <field name="sequence" />
                                    <field name="account_type_id" />
                                    <field name="account_id" />
                                    <field name="account_group_id" />
                                    <field name="partner_id" />
                                    <field name="name" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="debit" />
                                    <field name="credit" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b26d482_action" model="ir.actions.act_window">
        <field name="name">Worksheet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b26d482</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b26d482_menu"
        name="Worksheet"
        parent="ssi_general_audit.menu_rr_result"
        action="general_audit_ws_b26d482_action"
        sequence="5"
        groups="general_audit_ws_b26d482_viewer_group"
    />
</odoo>
