<odoo>

    <record id="general_audit_audit_procedure_view_search" model="ir.ui.view">
        <field name="name">general_audit_audit_procedure - search</field>
        <field name="model">general_audit_audit_procedure</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_audit_procedure_view_tree" model="ir.ui.view">
        <field name="name">general_audit_audit_procedure - tree</field>
        <field name="model">general_audit_audit_procedure</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="account_type_id" />
                    <field name="category_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_audit_procedure_view_form" model="ir.ui.view">
        <field name="name">general_audit_audit_procedure - form</field>
        <field name="model">general_audit_audit_procedure</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="account_type_id" />
                    <field
                        name="category_id"
                        domain="[('account_type_id', '=', account_type_id)]"
                    />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_audit_procedure_action" model="ir.actions.act_window">
        <field name="name">Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_audit_procedure</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_audit_procedure_menu"
        name="Audit Procedures"
        parent="ssi_general_audit.menu_configuration_risk_response"
        action="general_audit_audit_procedure_action"
        sequence="110"
        groups="general_audit_audit_procedure_group"
    />

</odoo>
