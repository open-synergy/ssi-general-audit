<odoo>

    <record id="general_audit_ws_e51bb1c_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_e51bb1c form</field>
        <field name="model">general_audit_ws_e51bb1c</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_e51bb1c_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_e51bb1c tree</field>
        <field name="model">general_audit_ws_e51bb1c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e51bb1c_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_e51bb1c form</field>
        <field name="model">general_audit_ws_e51bb1c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="detail" string="Detail">
                        <group name="detail_1" colspan="4" col="2">
                            <field name="account_type_id" />
                            <field
                                name="allowed_employee_ids"
                                widget="many2many_tags"
                                invisible="1"
                            />
                        </group>
                        <button
                            name="action_load_detail"
                            type="object"
                            string="Procedures"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="detail_ids">
                            <tree
                                editable="bottom"
                                create="false"
                                delete="false"
                                edit="false"
                            >
                                <field name="audit_procedure_category_id" />
                                <field
                                    name="step_ids"
                                    widget="many2many_tags"
                                    optional="hide"
                                />
                                <field
                                    name="assertion_type_ids"
                                    widget="many2many_tags"
                                    optional="hide"
                                />
                                <field
                                    name="employee_id"
                                    domain="[('id', 'in', parent.allowed_employee_ids)]"
                                />
                                <field name="status" />
                                <field name="reference" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="audit_procedure_category_id" />
                                        <field
                                            name="step_ids"
                                            widget="many2many_tags"
                                        />
                                        <field
                                            name="assertion_type_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="employee_id" />
                                        <field name="status" />
                                        <field name="reference" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e51bb1c_action" model="ir.actions.act_window">
        <field name="name">Key Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_e51bb1c</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_e51bb1c_menu"
        name="Key Audit Procedures"
        parent="ssi_general_audit.menu_rr_substantive_test"
        action="general_audit_ws_e51bb1c_action"
        sequence="3"
        groups="general_audit_ws_e51bb1c_viewer_group"
    />

    <menuitem
        id="general_audit_audit_procedure_root_menu"
        name="General Procedures"
        parent="ssi_general_audit.menu_risk_responses_root"
        sequence="2"
    />

    <menuitem
        id="general_audit_inspection_root_menu"
        name="Inspection"
        parent="general_audit_audit_procedure_root_menu"
        sequence="10"
    />
</odoo>
