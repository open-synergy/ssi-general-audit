msgstr ""
"Pilih sampel item persediaan dan bandingkan biaya tercatat dengan nilai realisasi bersihnya."

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:general_audit_audit_procedure,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_125_7nd8hfm
msgid ""
