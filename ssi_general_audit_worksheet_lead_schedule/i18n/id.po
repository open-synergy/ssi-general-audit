#: model:general_audit_audit_procedure_category,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_category_545_tm7bqtz
msgid "Review Payroll Tax Expense Calculation"
msgstr "Tinjau Perhitungan Beban Pajak Penggajian"

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:general_audit_audit_procedure,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_313_nhs0hne
msgid ""
"Review ROU asset additions, modifications, or disposals near the period-end "
"to confirm they are recorded in the correct period."
msgstr ""
"Tinjau penambahan, modifikasi, atau pelepasan aset ROU dekat akhir periode untuk "
"mengonfirmasi pencatatan pada periode yang benar."

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:general_audit_audit_procedure_category,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_category_506_ua9hxwp
