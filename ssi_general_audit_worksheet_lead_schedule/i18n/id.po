#: model:general_audit_audit_procedure,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_451_dfdxugu
msgid "Follow up on any discrepancies between bank confirmations and the entity’s records."
msgstr "Tindak lanjuti setiap selisih antara konfirmasi bank dan catatan entitas."

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:general_audit_audit_procedure,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_1046_hlaqkn1
