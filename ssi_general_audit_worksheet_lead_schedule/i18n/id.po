msgid "If checked, new messages require your attention."
msgstr "Jika dicentang, pesan baru memerlukan perhatian Anda."

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:ir.model.fields,help:ssi_general_audit_worksheet_lead_schedule.field_general_audit_audit_procedure__message_has_error
#: model:ir.model.fields,help:ssi_general_audit_worksheet_lead_schedule.field_general_audit_audit_procedure_category__message_has_error
#: model:ir.model.fields,help:ssi_general_audit_worksheet_lead_schedule.field_general_audit_ws_b26d482__message_has_error
