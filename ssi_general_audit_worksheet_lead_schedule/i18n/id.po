msgstr "Tinjau Peristiwa Subsekuen yang Mempengaruhi Laba atau Rugi"

#. module: ssi_general_audit_worksheet_lead_schedule
#: model:general_audit_audit_procedure_category,name:ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_category_472_xgkm7f5
msgid "Review Subsequent Events for Changes Affecting Retained Earnings"
msgstr "Tinjau Peristiwa Subsekuen untuk Perubahan yang Mempengaruhi Laba Ditahan"

#. module: ssi_general_audit_worksheet_lead_schedule
