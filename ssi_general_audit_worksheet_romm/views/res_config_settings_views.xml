<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.romm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="General Audit"
                    string="General Audit"
                    data-key="ssi_general_audit"
                >
                    <h2>ROMM</h2>
                    <div
                        class="row mt16 o_settings_container"
                        name="romm_setting_container"
                    >
                        <div
                            class="col-12 col-lg-6 o_setting_box"
                            id="romm_scoring_config_setting"
                        >
                            <div class="o_setting_right_pane">
                                <label for="romm_scoring_config_id" />
                                <div class="text-muted">
                                    Risk Configuration used to compute the Account Level ROMM
                                </div>
                                <field
                                    name="romm_scoring_config_id"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
