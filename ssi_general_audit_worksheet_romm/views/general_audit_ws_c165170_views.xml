<odoo>

    <record id="general_audit_ws_c165170_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_c165170 form</field>
        <field name="model">general_audit_ws_c165170</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_c165170_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_c165170 tree</field>
        <field name="model">general_audit_ws_c165170</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c165170_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_c165170 form</field>
        <field name="model">general_audit_ws_c165170</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="romm" string="ROMM">
                        <group
                            name="romm_1"
                            colspan="4"
                            col="2"
                            string="Fraud Factor Analysis"
                        >
                            <field
                                name="ws_c0e0eec_id"
                                string="# Worksheet"
                                domain="[('general_audit_id','=',general_audit_id)]"
                            />
                            <field name="ws_c0e0eec_id_review" string="Review Note" />
                        </group>
                        <group
                            name="romm_2"
                            colspan="4"
                            col="2"
                            string="Control Risk - Entity Level"
                        >
                            <field
                                name="ws_b59b886_id"
                                string="# Worksheet"
                                domain="[('general_audit_id','=',general_audit_id)]"
                            />
                            <field name="ws_b59b886_id_review" string="Review Note" />
                        </group>
                        <group
                            name="romm_2"
                            colspan="4"
                            col="2"
                            string="Understanding of preparation of Financial Statements"
                        >
                            <field
                                name="ws_f6a227_id"
                                string="# Worksheet"
                                domain="[('general_audit_id','=',general_audit_id)]"
                            />
                            <field name="ws_f6a227_id_review" string="Review Note" />
                        </group>
                        <separator string="Understanding of the business environment" />
                        <field
                            name="ws_bdcdfc5_ids"
                            domain="[('general_audit_id','=',general_audit_id)]"
                        >
                            <tree>
                                <field name="display_name" string="# Worksheet" />
                                <field name="review" />
                                <field name="state" invisible="1" />
                            </tree>
                        </field>
                        <group name="romm_1" colspan="4" col="2">
                            <field name="risk_material_missstatement" />
                            <field name="auditor_respons" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c165170_action" model="ir.actions.act_window">
        <field name="name">ROMM - Financial Level</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_c165170</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_c165170_menu"
        name="ROMM - Financial Level"
        parent="ssi_general_audit.menu_general_audit_romm"
        action="general_audit_ws_c165170_action"
        sequence="2"
        groups="general_audit_ws_c165170_viewer_group"
    />


</odoo>
