<odoo>

    <!-- SEARCH VIEW -->
    <record id="general_audit_ws_a3c9d2e_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a3c9d2e search</field>
        <field name="model">general_audit_ws_a3c9d2e</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="general_audit_ws_a3c9d2e_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a3c9d2e tree</field>
        <field name="model">general_audit_ws_a3c9d2e</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="general_audit_ws_a3c9d2e_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a3c9d2e form</field>
        <field name="model">general_audit_ws_a3c9d2e</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='conclusion_id']" position="before">
                    <field name="result" />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <group name="checklist_1" colspan="4" col="2">
                            <field name="business_cycle_id" />
                            <field
                                name="related_account_type_ids"
                                widget="many2many_tags"
                            />
                        </group>
                        <field name="checklist_ids">
                            <tree>
                                <field name="sequence" widget="handle" invisible="1" />
                                <field
                                    name="item_id"
                                    domain="[('business_cycle_id', '=', parent.business_cycle_id)]"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="procedure_ids" widget="many2many_tags" />
                                <field name="ref_document" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field
                                            name="item_id"
                                            domain="[('business_cycle_id', '=', parent.business_cycle_id)]"
                                            options="{'no_create': True, 'no_create_edit': True}"
                                        />
                                        <field name="ref_document" />
                                    </group>
                                    <field name="procedure_ids">
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle" />
                                            <field
                                                name="procedure_item_id"
                                                domain="[('category_id', '=', parent.item_id)]"
                                                options="{'no_create': True, 'no_create_edit': True}"
                                            />
                                            <field name="result" />
                                        </tree>
                                        <form>
                                            <group>
                                                <field
                                                    name="procedure_item_id"
                                                    domain="[('category_id', '=', parent.item_id)]"
                                                    options="{'no_create': True, 'no_create_edit': True}"
                                                />
                                                <field name="result" />
                                            </group>
                                        </form>
                                    </field>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='standard_audit']" position="before">
                    <page
                        name="checklist_conclusion"
                        string="Analytical Procedure Cycle Conclusion"
                    >
                        <field
                            name="checklist_ids"
                            attrs="{'readonly': [('state', '!=', 'open')]}"
                        >
                            <tree delete="false" editable="bottom">
                                <field name="worksheet_id" invisible="1" />
                                <field
                                    name="item_id"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="conclusion" />
                                <field name="attachment_ids" widget="many2many_tags" />
                            </tree>
                            <form>
                                <group>
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="item_id" />
                                    <field name="conclusion" />
                                    <field
                                        name="attachment_ids"
                                        widget="many2many_tags"
                                    />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ACTION -->
    <record id="general_audit_ws_a3c9d2e_action" model="ir.actions.act_window">
        <field name="name">Analytical Procedures – Cycle</field>
        <field name="res_model">general_audit_ws_a3c9d2e</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem
        id="general_audit_ws_a3c9d2e_menu"
        name="Analytical Procedures – Cycle"
        parent="ssi_general_audit.menu_rr_substantive_test"
        action="general_audit_ws_a3c9d2e_action"
        sequence="1"
        groups="general_audit_ws_a3c9d2e_viewer_group"
    />

</odoo>
