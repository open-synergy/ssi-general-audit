<odoo>

    <!-- SEARCH VIEW -->
    <record id="general_audit_ws_b4f8e1a_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f8e1a search</field>
        <field name="model">general_audit_ws_b4f8e1a</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="general_audit_ws_b4f8e1a_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f8e1a tree</field>
        <field name="model">general_audit_ws_b4f8e1a</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="general_audit_ws_b4f8e1a_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f8e1a form</field>
        <field name="model">general_audit_ws_b4f8e1a</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="examination_data" string="Examination Data">
                        <group name="examination_setup" colspan="4" col="2">
                            <group
                                name="examination_setup_source"
                                colspan="1"
                                col="2"
                                string="Sample Determination"
                            >
                                <field
                                    name="allowed_sample_determination_ids"
                                    invisible="1"
                                />
                                <field
                                    name="sample_determination_id"
                                    domain="[('id', 'in', allowed_sample_determination_ids)]"
                                />
                                <field name="population_count" readonly="1" />
                                <field name="sample_count" readonly="1" />
                            </group>
                            <group
                                name="examination_setup_parameters"
                                colspan="1"
                                col="2"
                                string="Difference Estimation Parameters"
                            >
                                <field name="performance_materiality" />
                                <field name="risk_factor" />
                                <field name="tolerable_misstatement" />
                                <field name="aria" />
                                <field name="aria_coefficient" readonly="1" />
                            </group>
                        </group>
                        <button
                            name="action_generate_examination_data"
                            type="object"
                            string="Generate Examination Data"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <div class="alert alert-info" role="alert">
                            One row per item sampled by the linked Sample
                            Determination worksheet. Fill in
                            <code>Audited Amount</code> for each row as the
                            substantive test is performed -- a blank row is
                            treated as not yet examined (difference of 0).
                        </div>
                        <field
                            name="examination_data"
                            nolabel="1"
                            widget="csv_table"
                            options="{'default_mode': 'table'}"
                        />
                    </page>
                    <page name="result_analysis" string="Result Analysis">
                        <group name="result_analysis_group" col="2">
                            <field name="average_difference" readonly="1" />
                            <field
                                name="population_difference_projection"
                                readonly="1"
                            />
                            <field name="population_standard_deviation" readonly="1" />
                            <field name="computed_precision_interval" readonly="1" />
                            <field name="upper_confidence_limit" readonly="1" />
                            <field name="lower_confidence_limit" readonly="1" />
                            <field name="conclusion_text" readonly="1" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ACTION -->
    <record id="general_audit_ws_b4f8e1a_action" model="ir.actions.act_window">
        <field name="name">Test of Detail</field>
        <field name="res_model">general_audit_ws_b4f8e1a</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem
        id="general_audit_ws_b4f8e1a_menu"
        name="Test of Detail"
        parent="ssi_general_audit.menu_rr_result"
        action="general_audit_ws_b4f8e1a_action"
        sequence="0"
        groups="general_audit_ws_b4f8e1a_viewer_group"
    />

</odoo>
