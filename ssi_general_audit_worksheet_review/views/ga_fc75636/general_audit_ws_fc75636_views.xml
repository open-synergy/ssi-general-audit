<odoo>

    <record id="general_audit_ws_fc75636_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_fc75636 form</field>
        <field name="model">general_audit_ws_fc75636</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_fc75636_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_fc75636 tree</field>
        <field name="model">general_audit_ws_fc75636</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_fc75636_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_fc75636 form</field>
        <field name="model">general_audit_ws_fc75636</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field
                                    name="checklist_type"
                                    string="Type"
                                    optional="hide"
                                />
                                <field name="category_id" optional="hide" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />

                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                    <field name="item_id" invisible="1" />
                                    <field name="checklist_type" string="Type" />
                                    <field name="category_id" />
                                    <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='checklist']" position="after">
                    <page name="links" string="Links">
                        <button
                            name="action_reload_links"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <group name="activity_1" string="Audit Final Memorandum">
                            <label
                                for="audit_final_memorandum_id"
                                string="# Worksheet"
                            />
                            <div class="o_row">
                                <field
                                    name="audit_final_memorandum_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                            </div>
                            <field name="proposed_audit_opinion_id" readonly="1" />
                        </group>
                    </page>
                </xpath>
                <!-- The base ssi_general_audit mixin view inserts
                     "standard_audit" right before "note" (in its OWN
                     xpath resolution, before this view is even applied),
                     which places it ahead of "checklist"/"links" defined
                     above (both also anchored "before note"). Move it to
                     sit right after "links" so the final notebook order
                     is: checklist, links, standard_audit, note, policy.
                     Same pattern as general_audit_ws_de69c2f_views.xml. -->
                <xpath expr="//page[@name='links']" position="after">
                    <xpath expr="//page[@name='standard_audit']" position="move" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_fc75636_action" model="ir.actions.act_window">
        <field name="name">Proposed Audit Opinion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_fc75636</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_fc75636_menu"
        name="Proposed Audit Opinion"
        parent="ssi_general_audit.menu_general_audit_final_report"
        action="general_audit_ws_fc75636_action"
        sequence="2"
        groups="general_audit_ws_fc75636_viewer_group"
    />
</odoo>
