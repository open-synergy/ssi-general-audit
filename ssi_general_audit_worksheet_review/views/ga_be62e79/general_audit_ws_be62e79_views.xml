<odoo>

    <record id="general_audit_ws_be62e79_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_be62e79 form</field>
        <field name="model">general_audit_ws_be62e79</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_be62e79_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_be62e79 tree</field>
        <field name="model">general_audit_ws_be62e79</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_be62e79_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_be62e79 form</field>
        <field name="model">general_audit_ws_be62e79</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" widget="handle" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="checklist_type" string="Type" />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                    <field name="item_id" invisible="1" />
                                    <field name="checklist_type" string="Type" />
                                    <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_be62e79_action" model="ir.actions.act_window">
        <field name="name">Financial Statement Disclosure Review</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_be62e79</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_be62e79_menu"
        name="Financial Statement Disclosure Review"
        parent="ssi_general_audit.menu_general_audit_final_disclosure"
        action="general_audit_ws_be62e79_action"
        sequence="1"
        groups="general_audit_ws_be62e79_viewer_group"
    />
</odoo>
