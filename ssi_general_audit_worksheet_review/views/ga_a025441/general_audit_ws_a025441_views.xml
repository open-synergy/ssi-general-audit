<odoo>

    <record id="general_audit_ws_a025441_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a025441 form</field>
        <field name="model">general_audit_ws_a025441</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_a025441_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a025441 tree</field>
        <field name="model">general_audit_ws_a025441</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a025441_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a025441 form</field>
        <field name="model">general_audit_ws_a025441</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <!-- Scoped to header_right: the plain //field[@name='reviewer_id']
                     also matches an unrelated invisible many2one_avatar field of
                     the same name inside header_left, earlier in document order,
                     which XPath's first-match semantics would pick instead. Odoo
                     view inheritance forbids "placeholder" as a selector
                     attribute, so the ancestor group is what disambiguates. -->
                <xpath
                    expr="//group[@name='header_right']//field[@name='reviewer_id']/.."
                    position="after"
                >
                    <field name="financial_accounting_standard_id" readonly="1" />
                </xpath>
                <xpath expr="//page[@name='standard_audit']" position="before">
                    <page name="checklist" string="Checklist">
                        <field
                            name="raw_data"
                            nolabel="1"
                            widget="csv_table"
                            placeholder="Paste the completed financial statement disclosure checklist (item, source standard, note, Yes/No/N-A status) as CSV."
                        />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a025441_action" model="ir.actions.act_window">
        <field name="name">Financial Statement Disclosure</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_a025441</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_a025441_menu"
        name="Financial Statement Disclosure"
        parent="ssi_general_audit.menu_general_audit_final_disclosure"
        action="general_audit_ws_a025441_action"
        sequence="2"
        groups="general_audit_ws_a025441_viewer_group"
    />
</odoo>
