<odoo>

    <record id="general_audit_ws_de69c2f_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f form</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f tree</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f form</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" widget="handle" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field
                                    name="checklist_type"
                                    string="Type"
                                    optional="hide"
                                />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                    <field name="item_id" invisible="1" />
                                    <field name="checklist_type" string="Type" />
                                    <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='checklist']" position="after">
                    <page name="audit_result" string="Audit Result">
                        <button
                            name="action_reload_audit_result"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <group name="audit_result" colspan="4" col="2">
                            <field name="audit_result_id" />
                        </group>
                    </page>
                    <page name="management_letter" string="Management Letter">
                        <button
                            name="action_reload_management_letter"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <group name="management_letter" colspan="4" col="2">
                            <field name="management_letter_id" />
                        </group>
                    </page>
                    <page
                        name="management_representation"
                        string="Management Representation"
                    >
                        <button
                            name="action_reload_management_representation"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <group name="management_representation" colspan="4" col="2">
                            <field name="management_representation_id" />
                        </group>
                    </page>
                </xpath>
                <!-- "Relevant Audit Standard Items" is inserted by the base
                     ssi_general_audit mixin right before "note", which puts
                     it ahead of "checklist" (defined above). Move it to sit
                     right after "management_representation" so the final
                     notebook order matches the requested sequence: checklist,
                     audit_result, management_letter,
                     management_representation, standard_audit, note,
                     policies. -->
                <xpath
                    expr="//page[@name='management_representation']"
                    position="after"
                >
                    <xpath expr="//page[@name='standard_audit']" position="move" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_action" model="ir.actions.act_window">
        <field name="name">Final Discussion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_de69c2f</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_de69c2f_menu"
        name="Final Discussion"
        parent="ssi_general_audit.menu_general_audit_final_discussion"
        action="general_audit_ws_de69c2f_action"
        sequence="1"
        groups="general_audit_ws_de69c2f_viewer_group"
    />
</odoo>
