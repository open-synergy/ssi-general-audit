<odoo>

    <record id="general_audit_ws_de69c2f_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f form</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f tree</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_de69c2f form</field>
        <field name="model">general_audit_ws_de69c2f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook" position="before">
                    <button
                        name="action_reload_links"
                        type="object"
                        string="Reload"
                        class="oe_highlight"
                        icon="fa-refresh"
                        attrs="{'invisible': [('state', 'not in', ['open'])]}"
                    />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="checklist" string="Checklist">
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" widget="handle" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field
                                    name="checklist_type"
                                    string="Type"
                                    optional="hide"
                                />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                    <field name="item_id" invisible="1" />
                                    <field name="checklist_type" string="Type" />
                                    <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='checklist']" position="after">
                    <page name="links" string="Links">
                        <group name="activity_1" string="Audit Result">
                            <label for="audit_result_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="audit_result_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="audit_result_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field name="audit_result_state" class="oe_inline" />
                            </div>
                            <field name="audit_result_conclusion" string="Conclusion" />
                        </group>
                        <group name="activity_2" string="Management Letter">
                            <label for="management_letter_id" string="# Worksheet" />
                            <div class="o_row">
                                <field
                                    name="management_letter_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="management_letter_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field
                                    name="management_letter_state"
                                    class="oe_inline"
                                />
                            </div>
                            <field
                                name="management_letter_conclusion"
                                string="Conclusion"
                            />
                        </group>
                        <group name="activity_3" string="Management Representation">
                            <label
                                for="management_representation_id"
                                string="# Worksheet"
                            />
                            <div class="o_row">
                                <field
                                    name="management_representation_id"
                                    class="oe_inline"
                                    force_save="1"
                                />
                                <label
                                    for="management_representation_state"
                                    string="State"
                                    style="font-weight: bold;"
                                />
                                <field
                                    name="management_representation_state"
                                    class="oe_inline"
                                />
                            </div>
                            <field
                                name="management_representation_conclusion"
                                string="Conclusion"
                            />
                        </group>
                    </page>
                </xpath>
                <!-- The base ssi_general_audit mixin view inserts
                     "standard_audit" right before "note" (in its OWN
                     xpath resolution, before this view is even applied),
                     which places it ahead of "checklist"/"links" defined
                     above (both also anchored "before note"). Move it to
                     sit right after "links" so the final notebook order
                     is: checklist, links, standard_audit, note, policy.
                     Verified against the LIVE resolved order via
                     view.read_combined(), not assumed from source
                     layout. -->
                <xpath expr="//page[@name='links']" position="after">
                    <xpath expr="//page[@name='standard_audit']" position="move" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_de69c2f_action" model="ir.actions.act_window">
        <field name="name">Final Discussion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_de69c2f</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_de69c2f_menu"
        name="Final Discussion"
        parent="ssi_general_audit.menu_general_audit_final_discussion"
        action="general_audit_ws_de69c2f_action"
        sequence="1"
        groups="general_audit_ws_de69c2f_viewer_group"
    />
</odoo>
