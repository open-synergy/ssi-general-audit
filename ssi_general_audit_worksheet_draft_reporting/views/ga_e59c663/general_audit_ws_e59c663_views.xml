<odoo>

    <!-- Rendered by GeneralAuditWSe59c663.fields_view_get (Python, via
         lxml.etree) and spliced in right after the "checklist" page
         that mixin.checklist auto-injects. See that method's
         docstring for why this cannot be a declarative xpath view. -->
    <template id="general_audit_ws_e59c663_review_checklist_page">
        <page name="review_checklist" string="Review Procedure Checklist">
            <button
                name="action_populate_review_checklist"
                string="Populate"
                type="object"
                icon="fa-refresh"
                class="oe_highlight"
                style="margin-right:4px"
                attrs="{'invisible': [('state', '!=', 'open')]}"
            />
            <field name="review_checklist_ids">
                <tree create="false" delete="false">
                    <field name="sequence" widget="handle" invisible="1" />
                    <field
                        name="item_id"
                        options="{'no_create': True, 'no_create_edit': True}"
                        style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                    />
                    <field name="allowed_option_ids" invisible="1" />
                    <field
                        name="option_id"
                        domain="[('id', 'in', allowed_option_ids)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <field name="comment" />
                </tree>
                <form>
                    <sheet>
                        <group>
                            <field name="item_id" invisible="1" />
                            <field name="item_name" />
                            <field name="allowed_option_ids" invisible="1" />
                            <field
                                name="option_id"
                                domain="[('id', 'in', allowed_option_ids)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="comment" />
                        </group>
                    </sheet>
                </form>
            </field>
        </page>
    </template>

    <record id="general_audit_ws_e59c663_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 form</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_e59c663_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 tree</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e59c663_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 form</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e59c663_action" model="ir.actions.act_window">
        <field name="name">Draft Financial Statements</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_e59c663</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_e59c663_menu"
        name="Draft Financial Statements"
        parent="ssi_general_audit.menu_general_audit_draft_reporting"
        action="general_audit_ws_e59c663_action"
        sequence="2"
        groups="general_audit_ws_e59c663_viewer_group"
    />
</odoo>
