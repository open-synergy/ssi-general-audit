<odoo>

    <record id="general_audit_ws_e59c663_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 form</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_e59c663_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 tree</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e59c663_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_e59c663 form</field>
        <field name="model">general_audit_ws_e59c663</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <!-- This page is deliberately NOT named "checklist":
                     MixinChecklist.fields_view_get() (see
                     ssi_general_audit/models/checklist/checklist_mixin.py)
                     always force-moves ANY page literally named
                     "checklist" to the front of the notebook, even
                     with _checklist_create_page=False (confirmed by
                     testing that name here and getting it pinned
                     first regardless of source order). Named
                     "completeness_checklist" instead so normal xpath
                     document order applies and this page can be
                     placed second, after "review_checklist" (order
                     verified against the LIVE resolved arch via
                     fields_view_get()). -->
                <xpath expr="//page[@name='standard_audit']" position="before">
                    <page name="review_checklist" string="Review Procedure Checklist">
                        <button
                            name="action_populate_review_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="review_checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" widget="handle" invisible="1" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                                <field name="comment" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="item_id" invisible="1" />
                                        <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                            options="{'no_create': True, 'no_create_edit': True}"
                                        />
                                        <field name="comment" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page
                        name="completeness_checklist"
                        string="Completeness of financial statements cheklist"
                    >
                        <button
                            name="action_populate_checklist"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <field name="checklist_ids">
                            <tree create="false" delete="false">
                                <field name="sequence" widget="handle" invisible="1" />
                                <field
                                    name="item_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field name="allowed_option_ids" invisible="1" />
                                <field
                                    name="option_id"
                                    domain="[('id', 'in', allowed_option_ids)]"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="item_id" invisible="1" />
                                        <field name="item_name" />
                                        <field
                                            name="allowed_option_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="option_id"
                                            domain="[('id', 'in', allowed_option_ids)]"
                                            options="{'no_create': True, 'no_create_edit': True}"
                                        />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_e59c663_action" model="ir.actions.act_window">
        <field name="name">Draft Financial Statements</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_e59c663</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_e59c663_menu"
        name="Draft Financial Statements"
        parent="ssi_general_audit.menu_general_audit_draft_reporting"
        action="general_audit_ws_e59c663_action"
        sequence="2"
        groups="general_audit_ws_e59c663_viewer_group"
    />
</odoo>
