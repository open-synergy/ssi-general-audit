<odoo>

    <record id="general_audit_ws_ff42fdc_layout_line_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc.layout_line - tree</field>
        <field name="model">general_audit_ws_ff42fdc.layout_line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="line_type" />
                <field
                    name="group_id"
                    attrs="{'invisible': [('line_type', '=', 'total')], 'required': [('line_type', '=', 'group')]}"
                />
                <field
                    name="total_type"
                    attrs="{'invisible': [('line_type', '=', 'group')], 'required': [('line_type', '=', 'total')]}"
                />
                <field
                    name="show_adjustment"
                    attrs="{'invisible': [('line_type', '=', 'group')]}"
                />
            </tree>
        </field>
    </record>

    <record id="general_audit_ws_ff42fdc_layout_line_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc.layout_line - form</field>
        <field name="model">general_audit_ws_ff42fdc.layout_line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="line_type" />
                        <field
                            name="group_id"
                            attrs="{'invisible': [('line_type', '=', 'total')], 'required': [('line_type', '=', 'group')]}"
                        />
                        <field
                            name="total_type"
                            attrs="{'invisible': [('line_type', '=', 'group')], 'required': [('line_type', '=', 'total')]}"
                        />
                        <field
                            name="show_adjustment"
                            attrs="{'invisible': [('line_type', '=', 'group')]}"
                        />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="general_audit_ws_ff42fdc_layout_line_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc.layout_line - search</field>
        <field name="model">general_audit_ws_ff42fdc.layout_line</field>
        <field name="arch" type="xml">
            <search>
                <field name="group_id" />
                <filter
                    name="group_by_line_type"
                    string="Line Type"
                    context="{'group_by': 'line_type'}"
                />
            </search>
        </field>
    </record>

    <record
        id="general_audit_ws_ff42fdc_layout_line_action"
        model="ir.actions.act_window"
    >
        <field name="name">Posture Report Layout</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_ff42fdc.layout_line</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_ff42fdc_layout_line_menu"
        name="Posture Report Layout"
        parent="ssi_general_audit.menu_configuration_acc_computation"
        action="general_audit_ws_ff42fdc_layout_line_action"
        sequence="16"
        groups="general_audit_ws_ff42fdc_viewer_group,ssi_general_audit.client_account_group_group"
    />
</odoo>
