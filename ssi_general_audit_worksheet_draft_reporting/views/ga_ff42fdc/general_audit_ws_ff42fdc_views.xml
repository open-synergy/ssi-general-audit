<odoo>

    <record id="general_audit_ws_ff42fdc_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc form</field>
        <field name="model">general_audit_ws_ff42fdc</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_ff42fdc_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc tree</field>
        <field name="model">general_audit_ws_ff42fdc</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ff42fdc_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_ff42fdc form</field>
        <field name="model">general_audit_ws_ff42fdc</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[1]" position="before">
                    <page name="posture" string="Posture Report">
                        <button
                            name="action_load_posture"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="posture_ids">
                            <tree
                                editable="bottom"
                                create="false"
                                delete="false"
                                decoration-bf="line_type == 'total'"
                            >
                                <field name="line_type" invisible="1" />
                                <field
                                    name="group_id"
                                    attrs="{'invisible': [('line_type', '=', 'total')]}"
                                />
                                <field
                                    name="total_type"
                                    attrs="{'invisible': [('line_type', '=', 'group')]}"
                                />
                                <field name="currency_id" invisible="1" />
                                <field name="unaudited" />
                                <field name="adjustment_debit" />
                                <field name="adjustment_credit" />
                                <field name="audited" />
                                <field name="previous" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="line_type" invisible="1" />
                                        <field
                                            name="group_id"
                                            attrs="{'invisible': [('line_type', '=', 'total')]}"
                                        />
                                        <field
                                            name="total_type"
                                            attrs="{'invisible': [('line_type', '=', 'group')]}"
                                        />
                                        <field name="currency_id" invisible="1" />
                                        <field name="unaudited" />
                                        <field name="adjustment_debit" />
                                        <field name="adjustment_credit" />
                                        <field name="audited" />
                                        <field name="previous" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='posture']" position="after">
                    <page name="opinion" string="Audit Opinion">
                        <group
                            name="finncial_statement_opinion"
                            colspan="4"
                            col="2"
                            string="Opinion on Financial Statement"
                        >
                            <field
                                name="financial_statement_opinion_id"
                                string="Opinion"
                            />
                            <field
                                name="financial_statement_opinion_date"
                                string="Date"
                            />
                        </group>
                        <group
                            name="compliance_law_opinion"
                            colspan="4"
                            col="2"
                            string="Opinion on Compliance with Laws and Regulations"
                        >
                            <field name="compliance_law_opinion_id" string="Opinion" />
                            <field name="compliance_law_opinion_date" string="Date" />
                        </group>
                        <group
                            name="compliance_internal_control_opinion"
                            colspan="4"
                            col="2"
                            string="Opinion on Compliance with Internal Control"
                        >
                            <field
                                name="compliance_internal_control_opinion_id"
                                string="Opinion"
                            />
                            <field
                                name="compliance_internal_control_opinion_date"
                                string="Date"
                            />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ff42fdc_action" model="ir.actions.act_window">
        <field name="name">Audit Result</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_ff42fdc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_ff42fdc_menu"
        name="Audit Result"
        parent="ssi_general_audit.menu_general_audit_final_discussion"
        action="general_audit_ws_ff42fdc_action"
        sequence="2"
        groups="general_audit_ws_ff42fdc_viewer_group"
    />
</odoo>
