<odoo>

    <record id="general_audit_ws_b555edd_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd form</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b555edd_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd tree</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd form</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page
                        name="statement_of_financial_position"
                        string="Statement of Financial Position"
                    >
                        <field name="reload_needs_confirm" invisible="1" />
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', True)]}"
                        />
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            confirm="Reload clears the figures you typed in on the equity and cash flow tabs. Are you sure?"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', False)]}"
                        />
                        <field name="sfp_detail_ids" nolabel="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="type_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" />
                                <field name="previous_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="type_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="current_balance" />
                                    <field name="previous_balance" />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page
                        name="statement_of_comprehensive_income"
                        string="Statement of Comprehensive Income"
                    >
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', True)]}"
                        />
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            confirm="Reload clears the figures you typed in on the equity and cash flow tabs. Are you sure?"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', False)]}"
                        />
                        <field name="soci_detail_ids" nolabel="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="type_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" />
                                <field name="previous_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="type_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="current_balance" />
                                    <field name="previous_balance" />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page
                        name="statement_of_changes_in_equity"
                        string="Statement of Changes in Equity"
                    >
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', True)]}"
                        />
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            confirm="Reload clears the figures you typed in on the equity and cash flow tabs. Are you sure?"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', False)]}"
                        />
                        <div class="alert alert-info" role="alert">
                            <p>
                                Opening and closing balances come from the trial
                                balance, summed by account type for each equity
                                component. Profit goes to Retained Earnings and OCI
                                to Other Comprehensive Income.
                            </p>
                            <p>
                                Type in the owner transactions yourself, signed by
                                their effect on the component:
                            </p>
                            <ul>
                                <li>
                                    <b>Issuance of Shares</b>: shares issued to the
                                    owners, on the share capital or paid in capital
                                    line. Positive when equity increases. Support it
                                    with the deed or the shareholders' resolution.
                                </li>
                                <li>
                                    <b>Treasury Shares</b>: shares bought back or
                                    reissued, on the treasury shares line. Negative
                                    when bought back, positive when reissued.
                                </li>
                                <li>
                                    <b>Addition of Reserves</b>: amount moved to
                                    reserves, on the reserve line. Enter the matching
                                    negative amount on the retained earnings line.
                                </li>
                                <li>
                                    <b>Dividends</b>: dividends declared, on the
                                    retained earnings line as a negative amount,
                                    because they reduce equity.
                                </li>
                            </ul>
                            <p>
                                Other Movement = Closing Balance - (Opening Balance
                                + Profit + OCI + owner transactions). It is 0 when
                                the whole movement is explained. Reload replaces
                                every figure, including the ones you typed in.
                            </p>
                        </div>
                        <separator string="Current Period" />
                        <field name="equity_current_ids" nolabel="1">
                            <tree create="false" delete="false" editable="bottom">
                                <field name="component_id" readonly="1" />
                                <field name="currency_id" invisible="1" />
                                <field name="state" invisible="1" />
                                <field name="opening_balance" />
                                <field name="profit" />
                                <field name="oci" />
                                <field
                                    name="issuance"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="treasury"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="reserve"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="dividend"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field name="other_movement" />
                                <field name="closing_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="component_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="opening_balance" />
                                    <field name="profit" />
                                    <field name="oci" />
                                    <field name="issuance" />
                                    <field name="treasury" />
                                    <field name="reserve" />
                                    <field name="dividend" />
                                    <field name="other_movement" />
                                    <field name="closing_balance" />
                                </group>
                            </form>
                        </field>
                        <separator string="Previous Period" />
                        <field name="equity_previous_ids" nolabel="1">
                            <tree create="false" delete="false" editable="bottom">
                                <field name="component_id" readonly="1" />
                                <field name="currency_id" invisible="1" />
                                <field name="state" invisible="1" />
                                <field name="opening_balance" />
                                <field name="profit" />
                                <field name="oci" />
                                <field
                                    name="issuance"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="treasury"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="reserve"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field
                                    name="dividend"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'open'])]}"
                                />
                                <field name="other_movement" />
                                <field name="closing_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="component_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="opening_balance" />
                                    <field name="profit" />
                                    <field name="oci" />
                                    <field name="issuance" />
                                    <field name="treasury" />
                                    <field name="reserve" />
                                    <field name="dividend" />
                                    <field name="other_movement" />
                                    <field name="closing_balance" />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page
                        name="statement_of_cash_flows"
                        string="Statement of Cash Flows"
                    >
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', True)]}"
                        />
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            confirm="Reload clears the figures you typed in on the equity and cash flow tabs. Are you sure?"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'open']), ('reload_needs_confirm', '=', False)]}"
                        />
                        <div class="alert alert-info" role="alert">
                            <p>
                                Indirect method. Reload starts from the profit before
                                tax, adds back the non-cash items, then adds the
                                change of each working capital account: an increase
                                of an asset is a cash outflow, an increase of a
                                liability is a cash inflow.
                            </p>
                            <p>
                                Investing and financing rows come from the change of
                                the related asset, borrowing and share accounts.
                                Rows without a calculation (for example Dividends
                                paid) are typed in by you: inflow positive, outflow
                                negative.
                            </p>
                            <p>
                                Difference = computed closing cash - closing cash
                                of the trial balance. It is 0 when every cash
                                movement is mapped; otherwise something is still
                                missing. Reload replaces every figure, including the
                                ones you typed in.
                            </p>
                        </div>
                        <separator string="Current Period" />
                        <field name="cashflow_current_ids" nolabel="1">
                            <tree
                                create="false"
                                delete="false"
                                editable="bottom"
                                decoration-bf="section == 'summary'"
                            >
                                <field name="item_id" readonly="1" />
                                <field name="section" invisible="1" />
                                <field name="calc_type" invisible="1" />
                                <field name="currency_id" invisible="1" />
                                <field name="state" invisible="1" />
                                <field
                                    name="amount"
                                    attrs="{'readonly': ['|', ('calc_type', '!=', 'manual'), ('state', 'not in', ['draft', 'open'])]}"
                                />
                            </tree>
                            <form>
                                <group>
                                    <field name="item_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="amount" />
                                </group>
                            </form>
                        </field>
                        <separator string="Previous Period" />
                        <field name="cashflow_previous_ids" nolabel="1">
                            <tree
                                create="false"
                                delete="false"
                                editable="bottom"
                                decoration-bf="section == 'summary'"
                            >
                                <field name="item_id" readonly="1" />
                                <field name="section" invisible="1" />
                                <field name="calc_type" invisible="1" />
                                <field name="currency_id" invisible="1" />
                                <field name="state" invisible="1" />
                                <field
                                    name="amount"
                                    attrs="{'readonly': ['|', ('calc_type', '!=', 'manual'), ('state', 'not in', ['draft', 'open'])]}"
                                />
                            </tree>
                            <form>
                                <group>
                                    <field name="item_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="amount" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_action" model="ir.actions.act_window">
        <field name="name">Report Formatting Control</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b555edd</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b555edd_menu"
        name="Report Formatting Control"
        parent="ssi_general_audit.menu_general_audit_draft_reporting"
        action="general_audit_ws_b555edd_action"
        sequence="1"
        groups="general_audit_ws_b555edd_viewer_group"
    />
</odoo>
