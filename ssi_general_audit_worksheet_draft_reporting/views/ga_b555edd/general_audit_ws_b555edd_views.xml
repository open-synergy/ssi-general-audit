<odoo>

    <record id="general_audit_ws_b555edd_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd form</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b555edd_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd tree</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd form</field>
        <field name="model">general_audit_ws_b555edd</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page
                        name="statement_of_financial_position"
                        string="Statement of Financial Position"
                    >
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'open'])]}"
                        />
                        <field name="sfp_detail_ids" nolabel="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="type_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" />
                                <field name="previous_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="type_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="current_balance" />
                                    <field name="previous_balance" />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page
                        name="statement_of_comprehensive_income"
                        string="Statement of Comprehensive Income"
                    >
                        <button
                            name="action_reload_account"
                            type="object"
                            string="Reload"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'open'])]}"
                        />
                        <field name="soci_detail_ids" nolabel="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="type_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="current_balance" />
                                <field name="previous_balance" />
                            </tree>
                            <form>
                                <group>
                                    <field name="type_id" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="current_balance" />
                                    <field name="previous_balance" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_action" model="ir.actions.act_window">
        <field name="name">Report Formatting Control</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b555edd</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b555edd_menu"
        name="Report Formatting Control"
        parent="ssi_general_audit.menu_general_audit_draft_reporting"
        action="general_audit_ws_b555edd_action"
        sequence="1"
        groups="general_audit_ws_b555edd_viewer_group"
    />
</odoo>
