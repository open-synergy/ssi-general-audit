<odoo>

    <record id="general_audit_ws_b555edd_equity_component_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd.equity_component - tree</field>
        <field name="model">general_audit_ws_b555edd.equity_component</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="type_ids" widget="many2many_tags" />
                <field name="receive_profit" />
                <field name="receive_oci" />
            </tree>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_equity_component_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd.equity_component - form</field>
        <field name="model">general_audit_ws_b555edd.equity_component</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <field name="name" />
                        <field name="sequence" />
                        <field name="type_ids" widget="many2many_tags" />
                        <field name="receive_profit" />
                        <field name="receive_oci" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="general_audit_ws_b555edd_equity_component_view_search"
        model="ir.ui.view"
    >
        <field name="name">general_audit_ws_b555edd.equity_component - search</field>
        <field name="model">general_audit_ws_b555edd.equity_component</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="type_ids" />
            </search>
        </field>
    </record>

    <record
        id="general_audit_ws_b555edd_equity_component_action"
        model="ir.actions.act_window"
    >
        <field name="name">Equity Component</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b555edd.equity_component</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b555edd_equity_component_menu"
        name="Equity Component"
        parent="ssi_general_audit.menu_configuration_acc_computation"
        action="general_audit_ws_b555edd_equity_component_action"
        sequence="16"
        groups="base.group_system"
    />
</odoo>
