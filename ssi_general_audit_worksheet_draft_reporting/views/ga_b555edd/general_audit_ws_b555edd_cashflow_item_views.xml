<odoo>

    <record id="general_audit_ws_b555edd_cashflow_item_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd.cashflow_item - tree</field>
        <field name="model">general_audit_ws_b555edd.cashflow_item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="section" />
                <field name="calc_type" />
                <field name="sign" />
                <field name="type_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_cashflow_item_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd.cashflow_item - form</field>
        <field name="model">general_audit_ws_b555edd.cashflow_item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <field name="name" />
                        <field name="sequence" />
                        <field name="section" />
                        <field name="calc_type" />
                        <field name="sign" />
                        <field name="type_ids" widget="many2many_tags" />
                        <field name="reference_type_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="general_audit_ws_b555edd_cashflow_item_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b555edd.cashflow_item - search</field>
        <field name="model">general_audit_ws_b555edd.cashflow_item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="type_ids" />
                <filter
                    name="group_by_section"
                    string="Section"
                    context="{'group_by': 'section'}"
                />
            </search>
        </field>
    </record>

    <record
        id="general_audit_ws_b555edd_cashflow_item_action"
        model="ir.actions.act_window"
    >
        <field name="name">Cash Flow Item</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b555edd.cashflow_item</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b555edd_cashflow_item_menu"
        name="Cash Flow Item"
        parent="ssi_general_audit.menu_configuration_acc_computation"
        action="general_audit_ws_b555edd_cashflow_item_action"
        sequence="17"
        groups="base.group_system"
    />
</odoo>
