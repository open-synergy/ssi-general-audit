<odoo>

    <record id="general_audit_ws_ba9b2f0_view_form_toc_attribute" model="ir.ui.view">
        <field name="name">general_audit_ws_ba9b2f0 form - ToC Attribute</field>
        <field name="model">general_audit_ws_ba9b2f0</field>
        <field name="mode">extension</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit_worksheet_control_risk.general_audit_ws_ba9b2f0_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='detail_1']" position="inside">
                    <field name="general_audit_id" invisible="1" />
                </xpath>
                <xpath
                    expr="//field[@name='detail_ids']/tree/field[@name='toc_analysis']"
                    position="before"
                >
                    <field
                        name="toc_attribute_id"
                        domain="[('worksheet_id.general_audit_id','=',parent.general_audit_id),('worksheet_id.account_type_id','=',parent.account_type_id)]"
                        options="{'no_create': True}"
                        attrs="{'readonly': [('rely_on_control', '!=', 'yes')]}"
                    />
                </xpath>
                <xpath
                    expr="//field[@name='detail_ids']/form//field[@name='toc_reference']"
                    position="before"
                >
                    <field
                        name="toc_attribute_id"
                        domain="[('worksheet_id.general_audit_id','=',parent.general_audit_id),('worksheet_id.account_type_id','=',parent.account_type_id)]"
                        options="{'no_create': True}"
                        attrs="{'readonly': [('rely_on_control', '!=', 'yes')]}"
                    />
                </xpath>
            </data>
        </field>
    </record>

</odoo>
