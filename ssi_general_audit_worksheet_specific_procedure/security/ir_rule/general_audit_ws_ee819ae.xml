<odoo>
<record id="general_audit_ws_ee819ae_internal_user_rule" model="ir.rule">
    <field name="name">Commitment and Contingent (ee819ae) - Internal Users</field>
    <field name="model_id" ref="model_general_audit_ws_ee819ae" />
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="domain_force">[
      ('user_id','=',user.id),
    ]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="general_audit_ws_ee819ae_company_rule" model="ir.rule">
    <field
            name="name"
        >Commitment and Contingent (ee819ae) - Responsible to company data</field>
    <field name="model_id" ref="model_general_audit_ws_ee819ae" />
    <field name="groups" eval="[(4, ref('general_audit_ws_ee819ae_company_group'))]" />
    <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="general_audit_ws_ee819ae_companies_rule" model="ir.rule">
    <field
            name="name"
        >Commitment and Contingent (ee819ae) - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_general_audit_ws_ee819ae" />
    <field
            name="groups"
            eval="[(4, ref('general_audit_ws_ee819ae_company_child_group'))]"
        />
    <field name="domain_force">[('company_id','in',user.company_ids.ids)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="general_audit_ws_ee819ae_all_rule" model="ir.rule">
    <field name="name">Commitment and Contingent (ee819ae) - All</field>
    <field name="model_id" ref="model_general_audit_ws_ee819ae" />
    <field name="groups" eval="[(4, ref('general_audit_ws_ee819ae_all_group'))]" />
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
