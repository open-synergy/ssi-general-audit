<odoo>

    <record id="general_audit_ws_c40cfd9_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_c40cfd9 form</field>
        <field name="model">general_audit_ws_c40cfd9</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_c40cfd9_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_c40cfd9 tree</field>
        <field name="model">general_audit_ws_c40cfd9</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c40cfd9_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_c40cfd9 form</field>
        <field name="model">general_audit_ws_c40cfd9</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page string="Related Parties">
                        <group name="related_party_1" colspan="4" col="2">
                            <field
                                name="ws_ae11f7e_id"
                                domain="[('general_audit_id', '=', general_audit_id)]"
                            />
                        </group>
                        <button
                            name="action_load_related_party"
                            string="Related Parties"
                            type="object"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="related_party_line_ids">
                            <tree>
                                <field name="name" />
                                <field name="initial_relation" />
                                <field
                                    name="initial_related_account_type_ids"
                                    widget="many2many_tags"
                                />
                                <field name="final_relation" />
                                <field
                                    name="final_related_account_type_ids"
                                    widget="many2many_tags"
                                />
                                <field name="reference" />
                                <field name="conclusion" />
                            </tree>
                            <form>
                                <sheet>
                                    <group name="related_party_1" colspan="4" col="2">
                                        <field name="name" />
                                        <field name="initial_relation" />
                                        <field
                                            name="initial_related_account_type_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="final_relation" />
                                        <field
                                            name="final_related_account_type_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="reference" />
                                        <field name="conclusion" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page string="Confirmation Procedures">
                        <button
                            name="action_load_confirmation_procedure"
                            string="Confirmation Procedures"
                            type="object"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="confirmation_procedure_line_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="confirmation_procedure_id" />
                                <field name="performed" />
                                <field name="reference" />
                            </tree>
                            <form>
                                <sheet>
                                    <group
                                        name="confirmation_procedure_1"
                                        colspan="4"
                                        col="2"
                                    >
                                        <field name="confirmation_procedure_id" />
                                        <field name="performed" />
                                        <field name="reference" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_c40cfd9_action" model="ir.actions.act_window">
        <field name="name">Related Party Transaction</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_c40cfd9</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_c40cfd9_menu"
        name="Related Party Transaction"
        parent="ssi_general_audit.menu_general_audit_specific_procedure"
        action="general_audit_ws_c40cfd9_action"
        sequence="2"
        groups="general_audit_ws_c40cfd9_viewer_group"
    />
</odoo>
