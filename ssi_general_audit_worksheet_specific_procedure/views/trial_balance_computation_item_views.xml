<odoo>
    <record id="trial_balance_computation_item_view_tree" model="ir.ui.view">
        <field name="name">trial_balance_computation_item - tree</field>
        <field name="model">trial_balance_computation_item</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.trial_balance_computation_item_view_tree"
        />
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="going_concern_ok" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="trial_balance_computation_item_view_form" model="ir.ui.view">
        <field name="name">trial_balance_computation_item - form</field>
        <field name="model">trial_balance_computation_item</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.trial_balance_computation_item_view_form"
        />
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="going_concern_ok" />
                </xpath>
            </data>
        </field>
    </record>


</odoo>
