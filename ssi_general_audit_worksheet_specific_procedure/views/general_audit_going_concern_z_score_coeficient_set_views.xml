<odoo>

    <record
        id="general_audit_going_concern_z_score_coeficient_set_view_search"
        model="ir.ui.view"
    >
        <field
            name="name"
        >general_audit_going_concern_z_score_coeficient_set - search</field>
        <field name="model">general_audit_going_concern_z_score_coeficient_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record
        id="general_audit_going_concern_z_score_coeficient_set_view_tree"
        model="ir.ui.view"
    >
        <field
            name="name"
        >general_audit_going_concern_z_score_coeficient_set - tree</field>
        <field name="model">general_audit_going_concern_z_score_coeficient_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record
        id="general_audit_going_concern_z_score_coeficient_set_view_form"
        model="ir.ui.view"
    >
        <field
            name="name"
        >general_audit_going_concern_z_score_coeficient_set - form</field>
        <field name="model">general_audit_going_concern_z_score_coeficient_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="coefficient" string="Coeficients">
                        <field name="item_ids">
                            <tree editable="bottom">
                                <field
                                    name="computation_item_id"
                                    domain="[('going_concern_ok','=',True)]"
                                />
                                <field name="coefficient" />
                            </tree>
                            <form>
                                <group>
                                    <field
                                        name="computation_item_id"
                                        domain="[('going_concern_ok','=',True)]"
                                    />
                                    <field name="coefficient" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record
        id="general_audit_going_concern_z_score_coeficient_set_action"
        model="ir.actions.act_window"
    >
        <field name="name">Going Concern Z-Score Coefficient Sets</field>
        <field name="type">ir.actions.act_window</field>
        <field
            name="res_model"
        >general_audit_going_concern_z_score_coeficient_set</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_going_concern_z_score_coeficient_set_menu"
        name="Going Concern Z-Score Coefficient Sets"
        parent="ssi_general_audit.menu_configuration_acc_computation"
        action="general_audit_going_concern_z_score_coeficient_set_action"
        sequence="70"
        groups="general_audit_going_concern_z_score_coeficient_set_group"
    />

</odoo>
