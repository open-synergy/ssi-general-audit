<odoo>

    <record id="general_audit_ws_fbf57ee_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_fbf57ee form</field>
        <field name="model">general_audit_ws_fbf57ee</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_fbf57ee_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_fbf57ee tree</field>
        <field name="model">general_audit_ws_fbf57ee</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_fbf57ee_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_fbf57ee form</field>
        <field name="model">general_audit_ws_fbf57ee</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page string="Computation">
                        <group name="computation" colspan="4" col="2">
                            <field name="z_score_coefficient_set_id" />
                            <field name="z_score" />
                            <field name="z_score_category" />
                        </group>
                        <button
                            name="action_load_computation"
                            type="object"
                            string="Computation"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft','open'])]}"
                        />
                        <field name="computation_line_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="computation_item_id" />
                                <field name="coefficient" />
                                <field name="current_amount" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="computation_item_id" />
                                        <field name="coefficient" />
                                        <field name="current_amount" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page string="Confirmation Procedures">
                        <button
                            name="action_load_confirmation_procedure"
                            type="object"
                            string="Confirmation Procedures"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft','open'])]}"
                        />
                        <field name="confirmation_procedure_line_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="confirmation_procedure_id" />
                                <field name="risk_assessment" />
                                <field name="explanation" />
                                <field name="reference" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="confirmation_procedure_id" />
                                        <field name="risk_assessment" />
                                        <field name="explanation" />
                                        <field name="reference" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page name="analysis" string="Analysis">
                        <button
                            name="action_load_analysis"
                            type="object"
                            string="Analysis"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft','open'])]}"
                        />
                        <field name="analysis_line_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="going_concern_category_id" />
                                <field name="going_concern_id" />
                                <field name="risk_assessment" />
                                <field name="explanation" />
                                <field name="reference" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="going_concern_category_id" />
                                        <field name="going_concern_id" />
                                        <field name="risk_assessment" />
                                        <field name="explanation" />
                                        <field name="reference" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_fbf57ee_action" model="ir.actions.act_window">
        <field name="name">Going Concern</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_fbf57ee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_fbf57ee_menu"
        name="Going Concern"
        parent="ssi_general_audit.menu_general_audit_specific_procedure"
        action="general_audit_ws_fbf57ee_action"
        sequence="4"
        groups="general_audit_ws_fbf57ee_viewer_group"
    />
</odoo>
