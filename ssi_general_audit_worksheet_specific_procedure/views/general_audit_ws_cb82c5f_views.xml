<odoo>

    <record id="general_audit_ws_cb82c5f_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_cb82c5f form</field>
        <field name="model">general_audit_ws_cb82c5f</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_cb82c5f_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_cb82c5f tree</field>
        <field name="model">general_audit_ws_cb82c5f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_cb82c5f_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_cb82c5f form</field>
        <field name="model">general_audit_ws_cb82c5f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page string="Subsequent Events">
                        <button
                            name="action_load_detail"
                            string="Detail"
                            type="object"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'open'])]}"
                        />
                        <field name="detail_ids">
                            <tree create="false" delete="false">
                                <field name="subsequent_event_id" />
                                <field name="occurance" />
                                <field name="currency_id" invisible="1" />
                                <field name="adjustment_ids" widget="many2many_tags" />
                                <field name="adjustment_dr" />
                                <field name="adjustment_cr" />
                                <field name="to_disclose" />
                                <field name="disclosure" />
                                <field name="reference" />
                            </tree>
                            <form>
                                <sheet>
                                    <group
                                        name="detail_1"
                                        colspan="4"
                                        col="2"
                                        string="Event Occurance"
                                    >
                                        <field name="subsequent_event_id" />
                                        <field name="occurance" />


                                    </group>
                                    <separator string="Adjustments" colspan="4" />
                                    <field
                                        name="adjustment_entry_detail_ids"
                                        domain="[('entry_id.general_audit_id', '=', parent.general_audit_id)]"
                                    />
                                    <group name="detail_2" colspan="4" col="2">
                                        <field name="currency_id" invisible="1" />
                                        <field name="adjustment_dr" />
                                        <field name="adjustment_cr" />
                                    </group>
                                    <group
                                        name="detail_3"
                                        colspan="4"
                                        col="2"
                                        string="Disclosures"
                                    >
                                        <field name="to_disclose" />
                                        <field name="disclosure" />
                                        <field name="reference" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_cb82c5f_action" model="ir.actions.act_window">
        <field name="name">Subsequent Event</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_cb82c5f</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_cb82c5f_menu"
        name="Subsequent Event"
        parent="ssi_general_audit.menu_general_audit_specific_procedure"
        action="general_audit_ws_cb82c5f_action"
        sequence="3"
        groups="general_audit_ws_cb82c5f_viewer_group"
    />
</odoo>
