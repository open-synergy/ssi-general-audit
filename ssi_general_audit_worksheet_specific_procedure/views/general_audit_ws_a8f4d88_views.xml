<odoo>

    <record id="general_audit_ws_a8f4d88_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a8f4d88 form</field>
        <field name="model">general_audit_ws_a8f4d88</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_a8f4d88_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a8f4d88 tree</field>
        <field name="model">general_audit_ws_a8f4d88</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a8f4d88_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a8f4d88 form</field>
        <field name="model">general_audit_ws_a8f4d88</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="detail" string="Details">
                        <field name="allowed_account_type_ids" invisible="1" />
                        <field name="detail_ids">
                            <tree>
                                <field name="account_type_id" />
                                <field name="expert_ids" widget="many2many_tags" />
                                <field
                                    name="estimation_method_ids"
                                    widget="many2many_tags"
                                />
                                <field name="assumption" />
                                <field name="relevant_control_id" />
                                <field name="fair_value_measurement_level" />
                                <field name="reference" />
                                <field name="conclusion" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="account_type_id" />
                                        <field
                                            name="expert_ids"
                                            widget="many2many_tags"
                                        />
                                        <field
                                            name="estimation_method_ids"
                                            widget="many2many_tags"
                                            domain="[('account_type_id', '=', account_type_id)]"
                                        />
                                        <field name="assumption" />
                                        <field name="relevant_control_id" />
                                        <field name="fair_value_measurement_level" />
                                        <field name="reference" />
                                        <field name="conclusion" />
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a8f4d88_action" model="ir.actions.act_window">
        <field name="name">Accounting Estimation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_a8f4d88</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_a8f4d88_menu"
        name="Accounting Estimation"
        parent="ssi_general_audit.menu_general_audit_specific_procedure"
        action="general_audit_ws_a8f4d88_action"
        sequence="1"
        groups="general_audit_ws_a8f4d88_viewer_group"
    />
</odoo>
