<odoo>

    <record id="general_audit_ws_a01723b_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_a01723b form</field>
        <field name="model">general_audit_ws_a01723b</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_a01723b_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_a01723b tree</field>
        <field name="model">general_audit_ws_a01723b</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="population_type_id" />
                </xpath>

            </data>
        </field>
    </record>

    <record id="general_audit_ws_a01723b_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_a01723b form</field>
        <field name="model">general_audit_ws_a01723b</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="raw_data" string="Raw Data">
                        <group name="raw_data_1" colspan="4" col="2">
                            <field name="population_type_id" />
                            <field name="raw_data_count" />
                        </group>
                        <field
                            name="raw_data"
                            nolabel="1"
                            class="oe_full_width"
                            widget="ace"
                        />
                    </page>
                    <page name="raw_data_preview" string="Raw Data Preview">
                        <field
                            name="raw_data_preview"
                            nolabel="1"
                            class="oe_full_width"
                            widget="ace"
                        />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_a01723b_action" model="ir.actions.act_window">
        <field name="name">Populations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_a01723b</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_a01723b_menu"
        name="Populations"
        parent="ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_root_menu"
        action="general_audit_ws_a01723b_action"
        sequence="120"
        groups="general_audit_ws_a01723b_viewer_group"
    />
</odoo>
