<odoo>

    <record id="general_audit_ws_d4d1ac0_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_d4d1ac0 form</field>
        <field name="model">general_audit_ws_d4d1ac0</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_d4d1ac0_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_d4d1ac0 tree</field>
        <field name="model">general_audit_ws_d4d1ac0</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                    <field name="key_audit_procedure_id" />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        optional="hide"
                    />
                    <field name="class_of_transaction_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d4d1ac0_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_d4d1ac0 form</field>
        <field name="model">general_audit_ws_d4d1ac0</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field
                        name="ws_e51bb1c_id"
                        domain="[('general_audit_id', '=', general_audit_id),('state','in',['open','done'])]"
                    />
                    <field
                        name="allowed_account_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                    />
                    <field
                        name="allowed_key_audit_procedure_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="key_audit_procedure_id"
                        domain="[('id', 'in', allowed_key_audit_procedure_ids)]"
                    />
                    <field name="detail_ws_e51bb1c_id" invisible="1" />
                    <field
                        name="allowed_assertion_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        domain="[('id','in', allowed_assertion_type_ids)]"
                    />
                    <field
                        name="allowed_class_of_transaction_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="class_of_transaction_id"
                        domain="[('id', 'in', allowed_class_of_transaction_ids)]"
                    />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="background" string="Background">
                        <field name="background" />
                    </page>
                    <page name="primary_concern" string="Primary Concern">
                        <field name="primary_concern" />
                    </page>
                    <page name="observations" string="Observations">
                        <field name="observation_ids">
                            <tree>
                                <field name="sequence" widget="handle" />
                                <field
                                    name="subject"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                                <field
                                    name="observation"
                                    style="white-space: normal; word-wrap: break-word; overflow-wrap: break-word;"
                                />
                            </tree>
                            <form>
                                <group>
                                    <field name="sequence" />
                                </group>
                                <notebook>
                                    <page
                                        name="subject_observation"
                                        string="Subject &amp; Observation"
                                    >
                                        <separator string="Subject" />
                                        <field name="subject" />
                                        <separator string="Observation" />
                                        <field name="observation" />
                                    </page>
                                </notebook>
                            </form>
                        </field>
                    </page>
                    <page name="summary" string="Summary">
                        <field name="summary" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d4d1ac0_action" model="ir.actions.act_window">
        <field name="name">Observation Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_d4d1ac0</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_d4d1ac0_menu"
        name="Observations"
        parent="ssi_general_audit_worksheet_lead_schedule.general_audit_audit_procedure_root_menu"
        action="general_audit_ws_d4d1ac0_action"
        sequence="120"
        groups="general_audit_ws_d4d1ac0_viewer_group"
    />
</odoo>
