<odoo>

    <record id="general_audit_ws_ae48e68_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_ae48e68 form</field>
        <field name="model">general_audit_ws_ae48e68</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_ae48e68_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_ae48e68 tree</field>
        <field name="model">general_audit_ws_ae48e68</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ae48e68_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_ae48e68 form</field>
        <field name="model">general_audit_ws_ae48e68</field>
        <field name="priority">100</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="date" string="Date">
                        <group name="date_1" colspan="4" cols="2">
                            <group name="mgmt" string="Management" colspan="1" cols="2">
                                <field
                                    name="mgmt_communication_planning_date"
                                    string="Planning"
                                />
                                <field
                                    name="mgmt_communication_date"
                                    string="Execution"
                                />
                                <field
                                    name="mgmt_communication_reporting_date"
                                    string="Reporting"
                                />
                            </group>
                            <group
                                name="ia"
                                string="Internal Audit"
                                colspan="1"
                                cols="2"
                            >
                                <field
                                    name="ia_communication_planning_date"
                                    string="Planning"
                                />
                                <field
                                    name="ia_communication_date"
                                    string="Execution"
                                />
                                <field
                                    name="ia_communication_reporting_date"
                                    string="Reporting"
                                />
                            </group>
                            <group name="tcwg" string="TCWG" colspan="1" cols="2">
                                <field
                                    name="tcwg_communication_planning_date"
                                    string="Planning"
                                />
                                <field
                                    name="tcwg_communication_date"
                                    string="Execution"
                                />
                                <field
                                    name="tcwg_communication_reporting_date"
                                    string="Reporting"
                                />
                            </group>
                        </group>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_ae48e68_action" model="ir.actions.act_window">
        <field name="name">External Communication</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_ae48e68</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_ae48e68_menu"
        name="External Communication"
        parent="ssi_general_audit.menu_general_audit_ra_external_communication"
        action="general_audit_ws_ae48e68_action"
        sequence="1"
        groups="general_audit_ws_ae48e68_viewer_group"
    />
</odoo>
