<odoo>
<!-- General Audit -->
<record id="approval_template_general_audit" model="approval.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_general_audit" />
    <field name="sequence" eval="100" />
    <field name="computation_method">use_python</field>
    <field name="python_code">result = True</field>
    <field name="validate_sequence" eval="1" />
</record>
<record id="approval_template_detail_general_audit" model="approval.template_detail">
    <field name="template_id" ref="approval_template_general_audit" />
    <field name="approver_selection_method">use_python</field>
    <field name="python_code">user = []
user += env.ref('ssi_general_audit.general_audit_validator_group').users.ids

if rec.reviewer_id:
    user.append(rec.reviewer_id.id)
    </field>
</record>
</odoo>
