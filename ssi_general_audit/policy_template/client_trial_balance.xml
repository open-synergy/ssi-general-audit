<odoo>
<!-- Trial Balance -->
<record id="policy_template_trial_balance" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_client_trial_balance" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','client_trial_balance'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Trial Balance: Start -->
<record id="policy_template_trial_balance_open" model="policy.template_detail">
    <field name="template_id" ref="policy_template_trial_balance" />
    <field
            name="field_id"
            search="[('model_id.model','=','client_trial_balance'),('name','=','open_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','client_trial_balance'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('trial_balance_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!--  Trial Balance: Confirm -->
<record id="policy_template_trial_balance_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_trial_balance" />
    <field
            name="field_id"
            search="[('model_id.model','=','client_trial_balance'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','client_trial_balance'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('trial_balance_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!--  Trial Balance: Cancel -->
<record id="policy_template_trial_balance_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_trial_balance" />
    <field
            name="field_id"
            search="[('model_id.model','=','client_trial_balance'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','client_trial_balance'),('value','in',['draft','open','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('trial_balance_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

