<odoo>
<!-- Adjustment Entry -->
<record id="policy_template_adjustment_entry" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','client_adjustment_entry'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!--  Adjustment Entry: Confirm -->
<record id="policy_template_adjustment_entry_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_adjustment_entry" />
    <field
            name="field_id"
            search="[('model_id.model','=','client_adjustment_entry'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','client_adjustment_entry'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id == document.user_id.id:
    result = True
elif env.user.id == document.reviewer_id.id:
    result = True
elif env.user.id == document.general_audit_id.user_id.id:
    result = True
elif env.user.id == document.general_audit_id.reviewer_id.id:
    result = True
elif env.user.id in env.ref("base.group_system").users.ids:
    result = True
elif env.user.id in env.ref("ssi_general_audit.adjustment_entry_validator_group").users.ids:
    result = True
    </field>
</record>

