<odoo>
<!-- Adjustment Entry -->
<record id="adjustment_entry_internal_user_rule" model="ir.rule">
    <field name="name">Adjustment Entry - Internal Users</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="domain_force">[
      '|',
      '|',
      '|',
      ('user_id','=',user.id),
      ('reviewer_id','=',user.id),
      ('general_audit_id.user_id','=',user.id),
      ('general_audit_id.reviewer_id','=',user.id),
    ]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="adjustment_entry_ou_role" model="ir.rule">
    <field name="name">Adjustment Entry - Responsible to operating unit data</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field name="groups" eval="[(4, ref('adjustment_entry_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="adjustment_entry_company_rule" model="ir.rule">
    <field name="name">Adjustment Entry - Responsible to company data</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field name="groups" eval="[(4, ref('adjustment_entry_company_group'))]" />
    <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="adjustment_entry_companies_rule" model="ir.rule">
    <field
            name="name"
        >Adjustment Entry - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field name="groups" eval="[(4, ref('adjustment_entry_company_child_group'))]" />
    <field name="domain_force">[('company_id','in',user.company_ids.ids)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="adjustment_entry_all_rule" model="ir.rule">
    <field name="name">Adjustment Entry - All</field>
    <field name="model_id" ref="model_client_adjustment_entry" />
    <field name="groups" eval="[(4, ref('adjustment_entry_all_group'))]" />
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
