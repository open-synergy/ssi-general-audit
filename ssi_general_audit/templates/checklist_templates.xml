<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="checklist_page">
        <page name="checklist" string="Checklist">
            <button
                name="action_populate_checklist"
                string="Populate"
                type="object"
                icon="fa-refresh"
                class="oe_highlight"
                style="margin-right:4px"
                attrs="{'invisible': [('state', '!=', 'open')]}"
            />
            <field name="checklist_ids">
                <tree editable="top">
                    <field name="sequence" widget="handle" />
                    <field
                        name="item_id"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <field name="allowed_option_ids" invisible="1" />
                    <field
                        name="option_id"
                        domain="[('id', 'in', allowed_option_ids)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                </tree>
                <form>
                    <sheet>
                        <group>
                            <field
                                name="item_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="allowed_option_ids" invisible="1" />
                            <field
                                name="option_id"
                                domain="[('id', 'in', allowed_option_ids)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                    </sheet>
                </form>
            </field>
        </page>
    </template>
</odoo>
