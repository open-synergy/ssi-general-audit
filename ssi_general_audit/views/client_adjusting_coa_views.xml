<odoo>

    <record id="client_adjusting_coa_view_search" model="ir.ui.view">
        <field name="name">client_adjusting_coa search</field>
        <field name="model">client_adjusting_coa</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
            <xpath expr="//filter[@name='grp_company']" position="after">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
        </field>
    </record>

    <record id="client_adjusting_coa_view_tree" model="ir.ui.view">
        <field name="name">client_adjusting_coa tree</field>
        <field name="model">client_adjusting_coa</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
                </xpath>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="general_audit_id" />
                    <field name="partner_id" widget="many2one_avatar" />
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="account_type_set_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="client_adjusting_coa_view_form" model="ir.ui.view">
        <field name="name">client_adjusting_coa form</field>
        <field name="model">client_adjusting_coa</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="general_audit_id" domain="[('state','=','open')]" />
                    <field name="partner_id" widget="many2one_avatar" />
                    <field name="account_type_set_id" />
                    <field name="currency_id" />
                    <field name="allowed_type_ids" invisible="1" />
                </xpath>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="previous_date_start" />
                    <field name="previous_date_end" />
                    <field name="interim_date_start" />
                    <field name="interim_date_end" />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="detail" string="Details">
                        <field name="detail_ids">
                            <tree editable="top">
                                <field name="code" />
                                <field name="name" />
                                <field
                                    name="type_id"
                                    domain="[('id','in',parent.allowed_type_ids)]"
                                />
                                <field name="account_id" />
                            </tree>
                            <form>
                                <group>
                                    <field name="code" />
                                    <field name="name" />
                                    <field
                                        name="type_id"
                                        domain="[('id','in',parent.allowed_type_ids)]"
                                    />
                                    <field name="account_id" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="client_adjusting_coa_action" model="ir.actions.act_window">
        <field name="name">Adjusting CoA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client_adjusting_coa</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'readonly_by_pass': True,
            'search_default_dom_draft':1,
            'search_default_dom_open':1,
            'search_default_dom_confirm':1,
            }
        </field>
    </record>

    <menuitem
        id="adjusting_coa_menu"
        name="Adjusting CoA"
        parent="ssi_general_audit.menu_rr_result"
        action="client_adjusting_coa_action"
        sequence="2"
        groups="client_adjusting_coa_viewer_group"
    />
</odoo>
