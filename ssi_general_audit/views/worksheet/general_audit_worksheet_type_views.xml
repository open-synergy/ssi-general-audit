<odoo>

    <record id="general_audit_worksheet_type_view_search" model="ir.ui.view">
        <field name="name">general_audit_worksheet_type - search</field>
        <field name="model">general_audit_worksheet_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="before">
                    <field name="code_internal" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_worksheet_type_view_tree" model="ir.ui.view">
        <field name="name">general_audit_worksheet_type - tree</field>
        <field name="model">general_audit_worksheet_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="before">
                    <field name="sequence" widget="handle" />
                </xpath>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="code_internal" />
                    <field name="main_worksheet" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_worksheet_type_view_form" model="ir.ui.view">
        <field name="name">general_audit_worksheet_type - form</field>
        <field name="model">general_audit_worksheet_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="code_internal" />
                </xpath>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="category_id" />
                    <field name="sequence" />
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'preview_image': 'image_256'}"
                        string="Image"
                    />
                </xpath>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="dependency" string="Dependencies">
                        <separator string="Predecessor" colspan="4" />
                        <field name="predecessor_ids" />
                        <separator string="Successor" colspan="4" />
                        <field name="successor_ids" />
                    </page>
                    <page name="technical" string="Technical Information">
                        <group name="technical_1" colspan="4" col="2">
                            <field name="model_name" />
                            <field name="main_worksheet" />
                            <field name="allowed_audit" />
                            <field
                                name="max_number_allowed"
                                attrs="{'invisible': [('allowed_audit', '=', False)]}"
                                placeholder="Please enter '0' for unlimited"
                            />
                        </group>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_worksheet_type_action" model="ir.actions.act_window">
        <field name="name">Worksheet Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_worksheet_type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_worksheet_type_menu"
        name="Types"
        parent="menu_configuration_worksheet"
        action="general_audit_worksheet_type_action"
        sequence="120"
        groups="general_audit_worksheet_type_group"
    />

</odoo>
