<odoo>

    <record id="general_audit_worksheet_mixin_view_search" model="ir.ui.view">
        <field name="name">general_audit_worksheet_mixin form</field>
        <field name="model">general_audit_worksheet_mixin</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_worksheet_mixin_view_tree" model="ir.ui.view">
        <field name="name">general_audit_worksheet_mixin tree</field>
        <field name="model">general_audit_worksheet_mixin</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="general_audit_id" />
                    <field name="type_id" invisible="1" />
                    <field name="partner_id" />
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="conclusion_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_worksheet_mixin_view_form" model="ir.ui.view">
        <field name="name">general_audit_worksheet_mixin form</field>
        <field name="model">general_audit_worksheet_mixin</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='footer']" position="after">
                    <group name="conclusion" colspan="4" col="2">
                        <field
                            name="conclusion_id"
                            domain="[('id','in',allowed_conclusion_ids)]"
                        />
                        <field name="conclusion" colspan="2" nolabel="1" />
                    </group>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="replace">
                </xpath>
                <xpath expr="//field[@name='reviewer_id']" position="replace">
                </xpath>
                <xpath expr="//field[@name='company_id']" position="replace">
                </xpath>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="date_start" invisible="1" />
                    <field name="date_end" invisible="1" />
                    <field name="interim_date_start" invisible="1" />
                    <field name="interim_date_end" invisible="1" />
                    <field name="previous_date_start" invisible="1" />
                    <field name="previous_date_end" invisible="1" />
                </xpath>
                <xpath expr="//page[@name='note']" position="after">
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
                <xpath expr="//notebook" position="before">
                    <notebook name="header">
                        <page name="general_info" string="General Information">
                            <group>
                                <field name="company_id" />
                                <field
                                    name="general_audit_id"
                                    domain="[('state','=','open')]"
                                />
                                <field
                                    name="account_type_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                                <field name="accountant_id" />
                                <field name="partner_id" />
                                <field name="title" />
                                <field name="type_id" readonly="1" force_save="1" />
                                <field name="parent_type_id" invisible="1" />
                                <field name="account_type_set_id" invisible="1" />
                                <field name="currency_id" invisible="1" />
                                <field
                                    name="allowed_conclusion_ids"
                                    widget="many2many_tags"
                                    invisible="1"
                                />
                            </group>
                        </page>
                        <page
                            name="responsible_reviewer"
                            string="Responsible &amp; Reviewer"
                        >
                            <group name="responsible_reviewer_1" colspan="4" col="2">
                                <group
                                    name="responsible"
                                    string="Responsible"
                                    colspan="1"
                                    col="2"
                                >
                                    <field name="user_id" string="Team Member" />
                                    <field name="preparation_date" string="Date" />
                                    <field
                                        name="preparation_time"
                                        string="Total (in minutes)"
                                    />
                                </group>
                                <group
                                    name="reviewer"
                                    string="Reviewer"
                                    colspan="1"
                                    col="2"
                                >
                                    <field name="reviewer_id" string="Team Member" />
                                    <field name="review_date" string="Date" />
                                    <field
                                        name="review_time"
                                        string="Total (in minutes)"
                                    />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
