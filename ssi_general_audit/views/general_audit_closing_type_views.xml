<odoo>

    <record id="general_audit_closing_type_view_search" model="ir.ui.view">
        <field name="name">general_audit_closing_type - search</field>
        <field name="model">general_audit_closing_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_closing_type_view_tree" model="ir.ui.view">
        <field name="name">general_audit_closing_type - tree</field>
        <field name="model">general_audit_closing_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_closing_type_view_form" model="ir.ui.view">
        <field name="name">general_audit_closing_type - form</field>
        <field name="model">general_audit_closing_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="mapping" string="Mapping">
                        <field name="mapping_ids" colspan="1" col="2" nolabel="1">
                            <tree>
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="source_type_ids" widget="many2many_tags" />
                                <field name="account_type_id" />
                            </tree>
                            <form>
                                <group name="mapping_form" colspan="4" col="2">
                                    <field name="sequence" />
                                    <field name="name" />
                                    <field
                                        name="source_type_ids"
                                        widget="many2many_tags"
                                    />
                                    <field name="account_type_id" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_closing_type_action" model="ir.actions.act_window">
        <field name="name">Closing Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_closing_type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_closing_type_menu"
        name="Closing Types"
        parent="menu_configuration_acc_computation"
        action="general_audit_closing_type_action"
        sequence="40"
        groups="general_audit_closing_type_group"
    />

</odoo>
