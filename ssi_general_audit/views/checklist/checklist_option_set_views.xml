<odoo>

    <record id="checklist_option_set_view_search" model="ir.ui.view">
        <field name="name">checklist_option_set - search</field>
        <field name="model">checklist.option_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="checklist_option_set_view_tree" model="ir.ui.view">
        <field name="name">checklist_option_set - tree</field>
        <field name="model">checklist.option_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="option_ids" widget="many2many_tags" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="checklist_option_set_view_form" model="ir.ui.view">
        <field name="name">checklist_option_set - form</field>
        <field name="model">checklist.option_set</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="options" string="Options">
                        <field name="option_ids" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="checklist_option_set_action" model="ir.actions.act_window">
        <field name="name">Option Sets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">checklist.option_set</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="checklist_option_set_menu"
        name="Option Sets"
        parent="checklist_option_root_menu"
        action="checklist_option_set_action"
        sequence="20"
        groups="checklist_option_configurator"
    />

</odoo>
