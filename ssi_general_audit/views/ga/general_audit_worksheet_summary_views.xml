<odoo>
<record id="general_audit_worksheet_summary_view_tree" model="ir.ui.view">
    <field name="name">general_audit.worksheet_summary - tree</field>
    <field name="model">general_audit.worksheet_summary</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <tree>
            <field name="type_id" />
            <field name="category_id" />
            <field name="max_worksheet" />
            <field name="is_required" />
            <field name="num_of_worksheet" />
            <field name="num_of_finish_worksheet" />
            <field name="finish" />
        </tree>
    </field>
</record>

<record id="general_audit_worksheet_summary_view_form" model="ir.ui.view">
    <field name="name">general_audit.worksheet_summary - form</field>
    <field name="model">general_audit.worksheet_summary</field>
    <field name="arch" type="xml">
        <form string="Worksheet Summary" class="o_form_image">
            <sheet>
                <!-- Header: gambar + judul + info singkat -->
                <div class="oe_title" style="align-items:center; gap:16px;">
                    <!-- Gambar: pakai image_128 sesuai model Anda -->
                    <field
                            name="image_128"
                            widget="image"
                            options="{'preview_image':'image_128'}"
                            class="oe_avatar"
                            style="border-radius:8px;"
                        />

                    <div>
                        <!-- Judul: Type -->
                        <h1 style="margin:0;">
                            <field name="type_id" readonly="1" />
                        </h1>
                        <!-- Subjudul: Category -->
                        <div style="color:#666; margin-top:4px;">
                            <span title="Category">
                                <i class="fa fa-tags" style="margin-right:6px;" />
                                <field name="category_id" readonly="1" />
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Baris metrik (ikon + angka) -->
                <group style="margin-top:8px;">
                    <div
                            style="display:flex; align-items:center; gap:20px; flex-wrap:wrap; font-size:13px;"
                        >
                        <span
                                title="Maximum worksheets allowed"
                                style="display:inline-flex; align-items:center;"
                            >
                            <i class="fa fa-flag" style="margin-right:6px;" />
                            <field name="max_worksheet" readonly="1" />
                        </span>
                        <span
                                title="Created worksheets"
                                style="display:inline-flex; align-items:center;"
                            >
                            <i class="fa fa-files-o" style="margin-right:6px;" />
                            <field name="num_of_worksheet" readonly="1" />
                        </span>
                        <span
                                title="Finished worksheets"
                                style="display:inline-flex; align-items:center;"
                            >
                            <i class="fa fa-check-square" style="margin-right:6px;" />
                            <field name="num_of_finish_worksheet" readonly="1" />
                        </span>
                        <!-- Status Required / Additional (ikon saja) -->
                        <span style="display:inline-flex; align-items:center;">
                            <field name="is_required" invisible="1" />
                            <label for="is_required" string="" invisible="1" />
                            <span
                                    t-if="record.is_required and record.is_required.raw_value"
                                >
                                <i
                                        class="fa fa-check-circle"
                                        title="Required worksheet"
                                        style="color:#007bff;"
                                    />
                            </span>
                            <span
                                    t-if="not (record.is_required and record.is_required.raw_value)"
                                >
                                <i
                                        class="fa fa-circle-o"
                                        title="Additional worksheet"
                                        style="color:#999;"
                                    />
                            </span>
                        </span>
                        <!-- Status Finish (ikon saja) -->
                        <span style="display:inline-flex; align-items:center;">
                            <field name="finish" invisible="1" />
                            <label for="finish" string="" invisible="1" />
                            <span t-if="record.finish and record.finish.raw_value">
                                <i
                                        class="fa fa-check"
                                        title="All worksheets finished"
                                        style="color:#28a745;"
                                    />
                            </span>
                            <span
                                    t-if="not (record.finish and record.finish.raw_value)"
                                >
                                <i
                                        class="fa fa-clock-o"
                                        title="In progress"
                                        style="color:#999;"
                                    />
                            </span>
                        </span>
                    </div>
                </group>
                <notebook>
                    <page name="worksheet" string="Worksheets">
                        <field name="worksheet_ids">
                            <tree>
                                <field name="name" />
                                <field name="parent_type_id" />
                                <field name="user_id" />
                                <field name="reviewer_id" />
                                <field name="state" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>


<record id="general_audit_worksheet_summary_view_kanban" model="ir.ui.view">
    <field name="name">general_audit.worksheet_summary - kanban</field>
    <field name="model">general_audit.worksheet_summary</field>
    <field name="arch" type="xml">
        <!-- biarkan Odoo atur lebar kolom; jangan pakai o_kanban_large_column -->
        <kanban default_group_by="category_id">
            <field name="general_audit_id" />
            <field name="type_id" />
            <field name="category_id" />
            <field name="is_required" />
            <field name="max_worksheet" />
            <field name="image_128" />
            <field name="num_of_worksheet" />
            <field name="num_of_finish_worksheet" />
            <field name="finish" />

<templates>
  <t t-name="kanban-box">
    <div
                            class="o_kanban_record oe_kanban_global_click"
                            style="display:flex;align-items:stretch;width:100%;max-width:100%;
             box-sizing:border-box;border:1px solid #d9d9d9;border-radius:10px;
             background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.06);
             margin-bottom:14px;padding:0;height:128px;
             position:relative; overflow:visible;"
                        >   <!-- penting: relative + visible -->

      <!-- ▼ tiga titik kanan-atas -->
      <div
                                class="o_dropdown_kanban dropdown"
                                style="position:absolute; top:6px; right:6px;"
                            >
        <a
                                    class="dropdown-toggle o-no-caret btn btn-link"
                                    data-toggle="dropdown"
                                    href="#"
                                    role="button"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                >
          <i class="fa fa-ellipsis-v" />
        </a>

        <div
                                    class="o_kanban_card_manage_pane dropdown-menu"
                                    role="menu"
                                    style="min-width: 200px;"
                                >
          <div class="o_kanban_card_manage_section">
            <div role="menuitem">
              <a type="object" name="action_open_worksheet">
                <i class="fa fa-folder-open" style="margin-right:6px;" />Open Worksheet
              </a>
            </div>
          </div>
        </div>
      </div>
      <!-- ▲ end tiga titik -->

      <!-- Panel kiri -->
      <div
                                style="width:100px;min-width:100px;background:#151515;display:flex;
                  align-items:center;justify-content:center;margin:0;padding:6px;"
                            >
        <field
                                    name="image_128"
                                    widget="image"
                                    options="{'preview_image':'image_128'}"
                                    class="o_kanban_image"
                                    style="max-width:85%;max-height:85%;object-fit:contain;border-radius:6px;"
                                />
      </div>

      <!-- Panel kanan -->
      <div
                                style="flex:1 1 auto;display:flex;flex-direction:column;justify-content:flex-start;
              padding:14px 20px;min-width:0;margin:0;"
                            >

        <!-- Judul / type -->
        <div
                                    style="font-weight:600;font-size:14px;color:#111;line-height:1.25;
                white-space:normal;word-break:break-word;display:-webkit-box;
                -webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;
                max-height:72px;"
                                >
          <t t-esc="record.type_id.value or ''" />
        </div>

        <!-- Row 1: Max, Created, Finished -->
        <div
                                    style="font-size:12px;color:#444;margin-top:6px;display:flex;align-items:center;gap:16px;"
                                >
          <span
                                        title="Maximum worksheets allowed"
                                        style="display:flex;align-items:center;"
                                    >
            <i class="fa fa-flag" style="margin-right:4px;" />
            <t t-esc="record.max_worksheet.value or 0" />
          </span>
          <span title="Created worksheets" style="display:flex;align-items:center;">
            <i class="fa fa-files-o" style="margin-right:4px;" />
            <t t-esc="record.num_of_worksheet.value or 0" />
          </span>
          <span title="Finished worksheets" style="display:flex;align-items:center;">
            <i class="fa fa-check-square" style="margin-right:4px;" />
            <t t-esc="record.num_of_finish_worksheet.value or 0" />
          </span>
        </div>

        <!-- Row 2: Required/Additional + Finish status -->
        <div
                                    style="font-size:12px;color:#666;margin-top:6px;display:flex;align-items:center;gap:16px;"
                                >
          <!-- Required / Additional -->
          <span>
            <t t-if="record.is_required.raw_value">
              <i
                                                class="fa fa-check-circle"
                                                title="Required worksheet"
                                                style="color:#007bff;font-size:13px;"
                                            />
            </t>
            <t t-else="">
              <i
                                                class="fa fa-circle-o"
                                                title="Additional worksheet"
                                                style="color:#999;font-size:13px;"
                                            />
            </t>
          </span>

          <!-- Finish status -->
          <span>
            <t t-if="record.finish.raw_value">
              <i
                                                class="fa fa-check"
                                                title="All worksheets finished"
                                                style="color:#28a745;font-size:13px;"
                                            />
            </t>
            <t t-else="">
              <i
                                                class="fa fa-clock-o"
                                                title="In progress"
                                                style="color:#999;font-size:13px;"
                                            />
            </t>
          </span>
        </div>
      </div>

    </div>
  </t>
</templates>

        </kanban>
    </field>
</record>




    <!-- 2) SEARCH VIEW dengan filter Group By Category -->
    <record id="general_audit_worksheet_summary_view_search" model="ir.ui.view">
        <field name="name">general_audit.worksheet_summary - search</field>
        <field name="model">general_audit.worksheet_summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="general_audit_id" />
                <field name="type_id" />
                <field name="category_id" />
                <filter
                    string="Required"
                    name="is_required_true"
                    domain="[('is_required','=',True)]"
                />
                <filter
                    string="Additional"
                    name="is_required_false"
                    domain="[('is_required','=',False)]"
                />

                <group expand="0" string="Group By">
                    <filter
                        string="Category"
                        name="group_by_category_id"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        string="Audit"
                        name="group_by_general_audit_id"
                        context="{'group_by': 'general_audit_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="general_audit_worksheet_summary_action" model="ir.actions.act_window">
        <field name="name">Worksheet Summary</field>
        <field name="res_model">general_audit.worksheet_summary</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">
            {
                'search_default_group_by_category_id': 1
            }
        </field>
    </record>
</odoo>
