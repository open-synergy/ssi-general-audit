<odoo>

    <record id="checklist_option_view_search" model="ir.ui.view">
        <field name="name">checklist_option - search</field>
        <field name="model">checklist.option</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="checklist_option_view_tree" model="ir.ui.view">
        <field name="name">checklist_option - tree</field>
        <field name="model">checklist.option</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="checklist_option_view_form" model="ir.ui.view">
        <field name="name">checklist_option - form</field>
        <field name="model">checklist.option</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="checklist_option_action" model="ir.actions.act_window">
        <field name="name">Options</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">checklist.option</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="checklist_option_menu"
        name="Options"
        parent="menu_configuration_general_audit"
        action="checklist_option_action"
        sequence="110"
        groups="checklist_option_configurator"
    />

</odoo>
