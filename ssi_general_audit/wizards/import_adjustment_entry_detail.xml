<odoo>

<record id="import_adjustment_entry_detail_view_form" model="ir.ui.view">
    <field name="name">import_adjustment_entry_detail - form</field>
    <field name="model">import_adjustment_entry_detail</field>
    <field name="arch" type="xml">
        <form>
            <group name="main" colspan="2" col="2">
                <field name="entry_id" invisible="1" />
                <field name="data" />
            </group>
            <footer>
                <button
                        name="button_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="import_adjustment_entry_detail_action" model="ir.actions.act_window">
    <field name="name">Import Adjustment Entry Detail</field>
    <field name="res_model">import_adjustment_entry_detail</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="import_adjustment_entry_detail_view_form" />
    <field name="target">new</field>
</record>

</odoo>
