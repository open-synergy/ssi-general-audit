<odoo>

    <record id="general_audit_ws_b59b886_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b59b886 form</field>
        <field name="model">general_audit_ws_b59b886</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b59b886_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b59b886 tree</field>
        <field name="model">general_audit_ws_b59b886</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b59b886_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b59b886 form</field>
        <field name="model">general_audit_ws_b59b886</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="detail" string="Details">
                        <button
                            name="action_populate"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '!=', 'open')]}"
                        />
                        <separator string="Evaluation of Control Understanding" />
                        <field name="general_control_ids" nolabel="1">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="detail_id" invisible="1" />
                                <field name="control_id" />
                                <field name="result" />
                                <field name="explanation" />
                            </tree>
                            <form>
                                <group name="group_1">
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="detail_id" invisible="1" />
                                    <field name="control_id" />
                                    <field name="result" />
                                    <field name="explanation" />
                                </group>
                            </form>
                        </field>
                        <separator
                            string="Evaluation of Information Technology Controls"
                        />
                        <field name="it_control_ids" nolabel="1">
                            <tree create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="detail_id" invisible="1" />
                                <field name="control_id" />
                                <field name="result" />
                                <field name="explanation" />
                            </tree>
                            <form>
                                <group name="group_1">
                                    <field name="worksheet_id" invisible="1" />
                                    <field name="detail_id" invisible="1" />
                                    <field name="control_id" />
                                    <field name="result" />
                                    <field name="explanation" />
                                </group>
                            </form>
                        </field>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
                <xpath expr="//group[@name='review']" position='before'>
                    <!-- Control Deficiency Identified -->
                    <div
                        style="display: flex; align-items: flex-start; margin-bottom: 8px; width: 100%;"
                    >

                        <label
                            string="Has any deficiency in internal control been identified based on the above understanding?"
                            style="font-weight: bold; white-space: normal; width: 600px;"
                        />
                        <span style="margin: 0 8px;">|</span>
                        <field
                            name="control_deficiency_identified"
                            readonly="1"
                            style="flex: 1;"
                        />
                    </div>

                    <!-- Significant Deficiency Identified -->
                    <div
                        style="display: flex; align-items: flex-start; margin-bottom: 8px; width: 100%;"
                    >

                        <label
                            string="Have any significant deficiencies been identified, either individually or in combination?"
                            style="font-weight: bold; white-space: normal; width: 600px;"
                        />
                        <span style="margin: 0 8px;">|</span>
                        <field
                            name="significant_deficiency_identified"
                            readonly="1"
                            style="flex: 1;"
                        />
                    </div>

                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b59b886_action" model="ir.actions.act_window">
        <field name="name">Control Risk - Entity Level</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b59b886</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b59b886_root"
        name="Control Risk - Entity Level"
        parent="ssi_general_audit.menu_general_audit_control_risk"
        sequence="2"
    />

    <menuitem
        id="general_audit_ws_b59b886_menu"
        name="Control Risk - Entity Level"
        parent="ssi_general_audit_worksheet_control_risk.general_audit_ws_b59b886_root"
        action="general_audit_ws_b59b886_action"
        sequence="1"
        groups="general_audit_ws_b59b886_viewer_group"
    />
</odoo>
