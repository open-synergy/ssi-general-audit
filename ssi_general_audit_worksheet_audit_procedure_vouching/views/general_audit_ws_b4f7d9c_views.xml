<odoo>

    <record id="general_audit_ws_b4f7d9c_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c search</field>
        <field name="model">general_audit_ws_b4f7d9c</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b4f7d9c_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c tree</field>
        <field name="model">general_audit_ws_b4f7d9c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_type_id" />
                    <field name="key_audit_procedure_id" />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        optional="hide"
                    />
                    <field name="data_mode" optional="hide" />
                    <field name="general_ledger_id" optional="hide" />
                    <field name="subledger_id" optional="hide" />
                    <field name="test_of_detail_id" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b4f7d9c_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c form</field>
        <field name="model">general_audit_ws_b4f7d9c</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field
                        name="ws_e51bb1c_id"
                        domain="[('general_audit_id', '=', general_audit_id),('state','in',['open','done'])]"
                    />
                    <field
                        name="allowed_account_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                    />
                    <field
                        name="allowed_key_audit_procedure_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="key_audit_procedure_id"
                        domain="[('id', 'in', allowed_key_audit_procedure_ids)]"
                    />
                    <field name="detail_ws_e51bb1c_id" invisible="1" />
                    <field
                        name="allowed_assertion_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="assertion_type_ids"
                        widget="many2many_tags"
                        domain="[('id','in', allowed_assertion_type_ids)]"
                    />
                    <field name="data_mode" />
                    <field name="allowed_general_ledger_ids" invisible="1" />
                    <field
                        name="general_ledger_id"
                        domain="[('id', 'in', allowed_general_ledger_ids)]"
                        attrs="{'invisible': [('data_mode', '!=', 'gl')]}"
                    />
                    <field name="allowed_subledger_ids" invisible="1" />
                    <field
                        name="subledger_id"
                        domain="[('id', 'in', allowed_subledger_ids)]"
                        attrs="{'invisible': [('data_mode', '!=', 'subledger')]}"
                    />
                    <field name="allowed_test_of_detail_ids" invisible="1" />
                    <field
                        name="test_of_detail_id"
                        domain="[('id', 'in', allowed_test_of_detail_ids)]"
                        attrs="{'invisible': [('data_mode', '=', False)]}"
                    />
                    <field name="reference_col_number" />
                </xpath>
                <xpath expr="//page[1]" position="before">
                    <page name="population" string="Population">
                        <field name="raw_data" widget="csv_table" />
                    </page>
                    <page name="sampling" string="Sampling">
                        <field name="sampling_data" nolabel="1" widget="csv_table" />
                    </page>
                    <page name="vouching_items" string="Vouching Items">
                        <field name="vouching_data" nolabel="1" widget="csv_table" />
                    </page>
                    <page name="data_comparisons" string="Data Comparisons">
                        <button
                            name="action_open_data_comparisons"
                            type="object"
                            string="Open Data Comparisons"
                            class="btn-primary"
                        />
                        <field name="data_comparison_ids" readonly="1" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="data_mode" />
                                <field name="general_ledger_id" />
                                <field name="subledger_id" />
                                <field name="reference_col_number" />
                            </tree>
                        </field>
                    </page>
                    <page name="vouching_lines" string="Vouching">
                        <button
                            name="action_open_vouching_lines"
                            type="object"
                            string="Open Vouching Lines"
                            class="btn-primary"
                        />
                        <field name="vouching_ids" readonly="1" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="sequence" widget="handle" />
                                <field name="data_comparison_id" />
                                <field name="comparison_mode" />
                                <field name="reference_amount_col" />
                                <field name="comparison_amount_col" />
                            </tree>
                        </field>
                    </page>
                    <page name="findings" string="Findings">
                        <field name="findings" />
                    </page>
                </xpath>
                <xpath expr="//notebook" position="after">
                    <group string="Worksheet Result" colspan="4" col="1">
                        <field
                            name="worksheet_result"
                            nolabel="1"
                            widget="html"
                            colspan="1"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b4f7d9c_action" model="ir.actions.act_window">
        <field name="name">Vouching Audit Procedures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b4f7d9c</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b4f7d9c_menu"
        name="Vouching"
        parent="ssi_general_audit_worksheet_lead_schedule.general_audit_inspection_root_menu"
        action="general_audit_ws_b4f7d9c_action"
        sequence="1"
        groups="general_audit_ws_b4f7d9c_viewer_group"
    />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Data Comparison                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="data_comparison_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c.data_comparison tree</field>
        <field name="model">general_audit_ws_b4f7d9c.data_comparison</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="worksheet_id" />
                <field name="name" />
                <field name="data_mode" />
                <field name="general_ledger_id" />
                <field name="subledger_id" />
                <field name="reference_col_number" />
            </tree>
        </field>
    </record>

    <record id="data_comparison_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c.data_comparison form</field>
        <field name="model">general_audit_ws_b4f7d9c.data_comparison</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="header_left">
                            <field name="worksheet_id" invisible="1" />
                            <field name="general_audit_id" invisible="1" />
                            <field name="sequence" />
                            <field name="name" />
                        </group>
                        <group name="header_center">
                            <field name="data_mode" />
                            <field name="allowed_general_ledger_ids" invisible="1" />
                            <field
                                name="general_ledger_id"
                                domain="[('id', 'in', allowed_general_ledger_ids)]"
                                attrs="{'invisible': [('data_mode', '!=', 'gl')]}"
                            />
                            <field name="allowed_subledger_ids" invisible="1" />
                            <field
                                name="subledger_id"
                                domain="[('id', 'in', allowed_subledger_ids)]"
                                attrs="{'invisible': [('data_mode', '!=', 'subledger')]}"
                            />
                            <field name="reference_col_number" />
                        </group>
                    </group>
                    <notebook>
                        <page name="raw_data" string="Raw Data">
                            <field name="raw_data" nolabel="1" widget="csv_table" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Vouching                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="vouching_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c.vouching tree</field>
        <field name="model">general_audit_ws_b4f7d9c.vouching</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="worksheet_id" />
                <field name="name" />
                <field name="data_comparison_id" />
                <field name="comparison_mode" />
                <field name="reference_amount_col" />
                <field name="comparison_amount_col" />
            </tree>
        </field>
    </record>

    <record id="vouching_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b4f7d9c.vouching form</field>
        <field name="model">general_audit_ws_b4f7d9c.vouching</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="header_left">
                            <field name="worksheet_id" invisible="1" />
                            <field name="sequence" />
                            <field name="name" />
                        </group>
                        <group name="header_center">
                            <field
                                name="data_comparison_id"
                                domain="[('worksheet_id', '=', worksheet_id)]"
                            />
                            <field name="comparison_mode" />
                            <field name="reference_amount_col" />
                            <field name="comparison_amount_col" />
                        </group>
                    </group>
                    <div>
                        <button
                            name="action_compute_vouching_data"
                            type="object"
                            string="Compute Vouching Data"
                            class="btn-primary"
                        />
                    </div>
                    <notebook>
                        <page name="vouching_data" string="Vouching Data">
                            <field
                                name="vouching_data"
                                nolabel="1"
                                widget="csv_table"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
