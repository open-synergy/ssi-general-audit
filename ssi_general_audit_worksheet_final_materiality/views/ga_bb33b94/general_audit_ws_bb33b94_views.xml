<odoo>

    <record id="general_audit_ws_bb33b94_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_bb33b94 form</field>
        <field name="model">general_audit_ws_bb33b94</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_bb33b94_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_bb33b94 tree</field>
        <field name="model">general_audit_ws_bb33b94</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_bb33b94_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_bb33b94 form</field>
        <field name="model">general_audit_ws_bb33b94</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="materiality" string="Final Materiality">
                        <group name="materiality_1" colspan="4" col="2">
                            <field
                                name="planning_ws_d9d2b44_id"
                                domain="[('general_audit_id','=',general_audit_id),('base_amount_source','=','extrapolation'),('state', 'in', ['open','done'])]"
                            />
                            <field
                                name="end_period_ws_d9d2b44_id"
                                domain="[('general_audit_id','=',general_audit_id),('base_amount_source','=','end_period'),('state', 'in', ['open','done'])]"
                            />
                        </group>
                        <group name="materiality_2" colspan="4" col="2">
                            <field
                                name="allowed_computation_item_ids"
                                widget="many2many_tags"
                                invisible="1"
                            />
                            <field
                                name="computation_item_id"
                                domain="[('id', 'in', allowed_computation_item_ids)]"
                            />
                            <field name="general_audit_computation_id" invisible="1" />
                            <field name="other_amount_ok" />
                            <field name="other_amount_source" />
                            <field name="other_base_amount" />
                            <field name="base_computation_amount" />
                        </group>
                        <group
                            name="materiality_3"
                            colspan="4"
                            col="2"
                            string="Overall Materiality"
                        >
                            <group name="materiality_3_1" colspan="1" col="2">
                                <field name="overall_materiality_percentage" />
                                <field
                                    name="planning_overall_materiality"
                                    string="Planning"
                                />
                                <field
                                    name="end_period_overall_materiality"
                                    string="Unaudited"
                                />
                                <field name="overall_materiality" string="Audited" />
                            </group>
                            <group name="materiality_3_2" colspan="1" col="2">
                                <field
                                    name="audited_unaudited_overall_materiality_diff"
                                    string="Audited - Unaudited Diff."
                                />
                                <field
                                    name="audited_unaudited_overall_materiality_diff_percentage"
                                    string="Diff. %"
                                />
                                <field
                                    name="audited_planning_overall_materiality_diff"
                                    string="Audited - Planning Diff."
                                />
                                <field
                                    name="audited_planning_overall_materiality_diff_percentage"
                                    string="Diff. %"
                                />
                            </group>
                        </group>
                        <group
                            name="materiality_4"
                            colspan="4"
                            col="2"
                            string="Performance Materiality"
                        >
                            <group name="materiality_4_1" colspan="1" col="2">
                                <field name="performance_materiality_percentage" />
                                <field
                                    name="planning_performance_materiality"
                                    string="Planning"
                                />
                                <field
                                    name="end_period_performance_materiality"
                                    string="Unaudited"
                                />
                                <field
                                    name="performance_materiality"
                                    string="Audited"
                                />
                            </group>
                            <group name="materiality_4_2" colspan="1" col="2">
                                <field
                                    name="audited_unaudited_performance_materiality_diff"
                                    string="Audited - Unaudited Diff."
                                />
                                <field
                                    name="audited_unaudited_performance_materiality_diff_percentage"
                                    string="Diff. %"
                                />
                                <field
                                    name="audited_planning_performance_materiality_diff"
                                    string="Audited - Planning Diff."
                                />
                                <field
                                    name="audited_planning_performance_materiality_diff_percentage"
                                    string="Diff. %"
                                />
                            </group>
                        </group>
                        <group
                            name="materiality_5"
                            colspan="4"
                            col="2"
                            string="Tolerable Misstatement"
                        >
                            <group name="materiality_5_1" colspan="1" col="2">
                                <field name="tolerable_misstatement_percentage" />
                                <field
                                    name="planning_tolerable_misstatement"
                                    string="Planning"
                                />
                                <field
                                    name="end_period_tolerable_misstatement"
                                    string="Unaudited"
                                />
                                <field name="tolerable_misstatement" string="Audited" />
                            </group>
                            <group name="materiality_5_2" colspan="1" col="2">
                                <field
                                    name="audited_unaudited_tolerable_misstatement_diff"
                                    string="Audited - Unaudited Diff."
                                />
                                <field
                                    name="audited_unaudited_tolerable_misstatement_diff_percentage"
                                    string="Diff. %"
                                />
                                <field
                                    name="audited_planning_tolerable_misstatement_diff"
                                    string="Audited - Planning Diff."
                                />
                                <field
                                    name="audited_planning_tolerable_misstatement_diff_percentage"
                                    string="Diff. %"
                                />
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_bb33b94_action" model="ir.actions.act_window">
        <field name="name">Final Materiality</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_bb33b94</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_bb33b94_menu"
        name="Final Materiality"
        parent="ssi_general_audit.menu_general_audit_final_materiality"
        action="general_audit_ws_bb33b94_action"
        sequence="1"
        groups="general_audit_ws_bb33b94_viewer_group"
    />
</odoo>
