<odoo>

    <record id="general_audit_ws_f3a78de_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f3a78de form</field>
        <field name="model">general_audit_ws_f3a78de</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_f3a78de_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f3a78de tree</field>
        <field name="model">general_audit_ws_f3a78de</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f3a78de_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f3a78de form</field>
        <field name="model">general_audit_ws_f3a78de</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="ratio" string="Ratios">
                        <group name="ratio_header">
                            <field
                                name="ws_d4289e4_id"
                                domain="[('general_audit_id','=',general_audit_id),('base_amount_source','=','end_period'),('state','in',['open','done'])]"
                            />
                        </group>
                        <button
                            name="action_reload_ratio"
                            type="object"
                            string="Detail"
                            icon="fa-refresh"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                            style="margin-right:4px"
                        />
                        <button
                            name="action_compute_ratio"
                            type="object"
                            string="Compute"
                            icon="fa-calculator"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="ratio_ids">
                            <tree
                                editable="top"
                                force_save="1"
                                delete="false"
                                create="false"
                            >
                                <field name="financial_ratio_id" readonly="1" />
                                <field name="category" />
                                <field name="audited_amount" string="Audited" />
                                <field name="previous_amount" string="Previous" />
                                <field name="industry_average" />
                                <field name="analysis" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f3a78de_action" model="ir.actions.act_window">
        <field name="name">Ratio Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_f3a78de</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_f3a78de_menu"
        name="Ratio Analysis"
        parent="ssi_general_audit.menu_general_audit_final_analytical_procedure"
        action="general_audit_ws_f3a78de_action"
        sequence="2"
        groups="general_audit_ws_f3a78de_viewer_group"
    />
</odoo>
