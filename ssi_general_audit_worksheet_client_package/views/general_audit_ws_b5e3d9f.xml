<odoo>

    <record id="general_audit_ws_b5e3d9f_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_b5e3d9f form</field>
        <field name="model">general_audit_ws_b5e3d9f</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_b5e3d9f_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_b5e3d9f tree</field>
        <field name="model">general_audit_ws_b5e3d9f</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b5e3d9f_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_b5e3d9f form</field>
        <field name="model">general_audit_ws_b5e3d9f</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field
                        name="allowed_account_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_id"
                        domain="[('id', 'in', allowed_account_ids)]"
                    />
                </xpath>
                <xpath expr="//notebook/page[1]" position="before">
                    <page name="raw_data" string="Raw Data">
                        <group name="raw_1" colspan="4" col="2">
                            <group name="raw_1_1" colspan="1" col="2">
                                <field name="amount_col_number" />
                            </group>
                            <group name="raw_1_2" colspan="1" col="2">
                                <field name="amount" />
                            </group>
                        </group>
                        <field name="raw_data" nolabel="1" widget="ace" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_b5e3d9f_action" model="ir.actions.act_window">
        <field name="name">Subledgers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_b5e3d9f</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_b5e3d9f_menu"
        name="Subledgers"
        parent="ssi_general_audit.menu_general_audit_client_package"
        action="general_audit_ws_b5e3d9f_action"
        sequence="4"
        groups="general_audit_ws_b5e3d9f_viewer_group"
    />
</odoo>
