<odoo>

    <record id="general_audit_ws_f5a3cee_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f5a3cee form</field>
        <field name="model">general_audit_ws_f5a3cee</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_f5a3cee_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f5a3cee tree</field>
        <field name="model">general_audit_ws_f5a3cee</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f5a3cee_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f5a3cee form</field>
        <field name="model">general_audit_ws_f5a3cee</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='standard_audit']" position="replace">
                </xpath>
                <xpath expr="//page[@name='note']" position='before'>
                    <page name="details" string="Details">
                        <button
                            name="action_populate_details"
                            string="Populate"
                            type="object"
                            icon="fa-refresh"
                            class="oe_highlight"
                            style="margin-right:4px"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                        />
                        <field
                            name="detail_ids"
                            attrs="{'readonly': [('state', '!=', 'open')]}"
                        >
                            <tree>
                                <field name="worksheet_id" invisible="1" />
                                <field name="account_client_type_id" />
                                <field name="line_count" invisible="1" />
                                <field
                                    name="line_done_count"
                                    widget="progressbar"
                                    string="Completed"
                                    options="{'current_value': 'line_done_count', 'max_value': 'line_count'}"
                                />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="worksheet_id" invisible="1" />
                                        <field name="id" invisible="1" />
                                        <field
                                            name="account_client_type_id"
                                            attrs="{'readonly': [('id', '!=', False)]}"
                                        />
                                        <field name="line_count" invisible="1" />
                                        <field
                                            name="line_done_count"
                                            widget="progressbar"
                                            string="Completed"
                                            options="{'current_value': 'line_done_count', 'max_value': 'line_count'}"
                                        />
                                        <field name="complete_ok" invisible="1" />
                                        <field name="state" invisible="1" />
                                    </group>
                                    <group string="Data Collection">
                                        <field
                                            name="line_ids"
                                            nolabel="1"
                                            context="{'data_collection_code_only': True}"
                                            attrs="{'readonly': [('state', '!=', 'open')]}"
                                        >
                                            <tree editable="bottom">
                                                <field
                                                    name="worksheet_id"
                                                    invisible="1"
                                                />
                                                <field
                                                    name="data_collection_id"
                                                    width="80px"
                                                    options="{'no_create': True, 'no_open': True}"
                                                    context="{'data_collection_code_only': True}"
                                                />
                                                <field name="name" width="220px" />
                                                <field
                                                    name="category_id"
                                                    width="130px"
                                                    options="{'no_create': True, 'no_open': True}"
                                                />
                                                <field name="date" width="90px" />
                                                <field
                                                    name="attachment_ids"
                                                    width="130px"
                                                    widget="many2many_tags"
                                                />
                                                <field name="id" invisible="1" />
                                                <button
                                                    name="%(general_audit_ws_f5a3cee_attachment_upload_action)d"
                                                    type="action"
                                                    title="Upload Attachment"
                                                    icon="fa-upload"
                                                    attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'open')]}"
                                                />
                                                <field
                                                    name="complete_ok"
                                                    width="60px"
                                                    widget="boolean_toggle"
                                                />
                                                <field name="state" invisible="1" />
                                            </tree>
                                            <form>
                                                <group>
                                                    <field
                                                        name="worksheet_id"
                                                        invisible="1"
                                                    />
                                                    <field
                                                        name="data_collection_id"
                                                        options="{'no_create': True, 'no_open': True}"
                                                        context="{'data_collection_code_only': True}"
                                                    />
                                                    <field name="name" />
                                                    <field
                                                        name="category_id"
                                                        options="{'no_create': True, 'no_open': True}"
                                                    />
                                                    <field name="date" />
                                                    <field
                                                        name="attachment_ids"
                                                        widget="many2many_tags"
                                                    />
                                                    <field
                                                        name="complete_ok"
                                                        widget="boolean_toggle"
                                                    />
                                                    <field name="state" invisible="1" />
                                                </group>
                                            </form>
                                        </field>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page name="standard_audit" string="Relevant Audit Standard Items">
                        <field name="standard_item_ids" nolabel="1" />
                    </page>
                </xpath>
                <xpath expr="//page[@name='details']" position="after">
                    <page name="others" string="Others">
                        <field
                            name="reporting_timetable_ids"
                            nolabel="1"
                            context="{'data_collection_code_only': True}"
                            attrs="{'readonly': [('state', '!=', 'open')]}"
                        >
                            <tree editable="bottom">
                                <field name="worksheet_id" invisible="1" />
                                <field
                                    name="data_collection_id"
                                    width="80px"
                                    options="{'no_create': True, 'no_open': True}"
                                    context="{'data_collection_code_only': True}"
                                />
                                <field name="description" string="Name" width="220px" />
                                <field
                                    name="category_id"
                                    width="130px"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                                <field name="date" width="90px" />
                                <field
                                    name="attachment_ids"
                                    width="130px"
                                    widget="many2many_tags"
                                />
                                <field name="id" invisible="1" />
                                <button
                                    name="%(general_audit_ws_f5a3cee_attachment_upload_action)d"
                                    type="action"
                                    title="Upload Attachment"
                                    icon="fa-upload"
                                    attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'open')]}"
                                />
                                <field
                                    name="complete_ok"
                                    width="60px"
                                    widget="boolean_toggle"
                                />
                                <field name="state" invisible="1" />
                            </tree>
                            <form>
                                <group>
                                    <field name="worksheet_id" invisible="1" />
                                    <field
                                        name="data_collection_id"
                                        options="{'no_create': True, 'no_open': True}"
                                        context="{'data_collection_code_only': True}"
                                    />
                                    <field name="description" string="Name" />
                                    <field
                                        name="category_id"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field name="date" />
                                    <field
                                        name="attachment_ids"
                                        widget="many2many_tags"
                                    />
                                    <field name="complete_ok" widget="boolean_toggle" />
                                    <field name="state" invisible="1" />
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_f5a3cee_action" model="ir.actions.act_window">
        <field name="name">Data Collection</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_f5a3cee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_f5a3cee_menu"
        name="Data Collection"
        parent="ssi_general_audit.menu_general_audit_client_package"
        action="general_audit_ws_f5a3cee_action"
        sequence="2"
        groups="general_audit_ws_f5a3cee_viewer_group"
    />
</odoo>
