<odoo>

    <record id="general_audit_ws_d209914_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_d209914 form</field>
        <field name="model">general_audit_ws_d209914</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="general_audit_ws_d209914_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_d209914 tree</field>
        <field name="model">general_audit_ws_d209914</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='general_audit_id']" position="after">
                    <field name="account_mode" />
                    <field name="account_id" optional="show" />
                    <field name="account_type_id" optional="show" />
                    <field name="title" optional="show" />
                    <field name="identifier_col_number" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d209914_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_d209914 form</field>
        <field name="model">general_audit_ws_d209914</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='header_center']" position="inside">
                    <field name="account_mode" />
                    <field
                        name="allowed_account_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_id"
                        domain="[('id', 'in', allowed_account_ids)]"
                        attrs="{'invisible': [('account_mode', '!=', 'account')]}"
                    />
                    <field
                        name="allowed_account_type_ids"
                        widget="many2many_tags"
                        invisible="1"
                    />
                    <field
                        name="account_type_id"
                        domain="[('id', 'in', allowed_account_type_ids)]"
                        attrs="{'invisible': [('account_mode', '!=', 'standard_account')]}"
                    />
                    <field name="title" />
                </xpath>
                <xpath expr="//notebook/page[1]" position="before">
                    <page name="raw_data" string="Raw Data">
                        <group name="raw_sep" colspan="4" col="2">
                            <field name="thousand_separator" />
                            <field name="decimal_separator" />
                        </group>
                        <group name="raw_1" colspan="4" col="2">
                            <group name="raw_1_1" colspan="1" col="2">
                                <field name="debit_col_number" />
                                <field name="credit_col_number" />
                                <field name="identifier_col_number" />
                            </group>
                            <group name="raw_1_2" colspan="1" col="2">
                                <field name="debit" />
                                <field name="credit" />
                                <field name="balance" />
                                <field name="initial_balance" />
                                <field name="ending_balance" />
                            </group>
                        </group>
                        <field name="raw_data" nolabel="1" widget="csv_table" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_ws_d209914_action" model="ir.actions.act_window">
        <field name="name">General Ledgers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_ws_d209914</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="general_audit_ws_d209914_menu"
        name="General Ledgers"
        parent="ssi_general_audit.menu_general_audit_client_package"
        action="general_audit_ws_d209914_action"
        sequence="3"
        groups="general_audit_ws_d209914_viewer_group"
    />
</odoo>
