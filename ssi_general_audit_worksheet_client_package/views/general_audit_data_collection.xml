<odoo>

    <record id="general_audit_data_collection_view_search" model="ir.ui.view">
        <field name="name">general_audit_data_collection - search</field>
        <field name="model">general_audit_data_collection</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//search" position="inside">
                    <group name="group_by" string="Group By">
                        <filter
                            name="grp_type"
                            string="Type"
                            context="{'group_by': 'type'}"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_data_collection_view_tree" model="ir.ui.view">
        <field name="name">general_audit_data_collection - tree</field>
        <field name="model">general_audit_data_collection</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="type" />
                    <field name="account_type_id" />
                    <field name="category_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_data_collection_view_form" model="ir.ui.view">
        <field name="name">general_audit_data_collection - form</field>
        <field name="model">general_audit_data_collection</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="type" />
                    <field
                        name="account_type_id"
                        attrs="{'invisible': [('type', '!=', 'account_type')], 'required': [('type', '=', 'account_type')]}"
                    />
                    <field
                        name="category_id"
                        attrs="{'invisible': [('type', '=', 'primary')], 'required': [('type', '!=', 'primary')]}"
                    />
                </xpath>
            </data>
        </field>
    </record>

    <record id="general_audit_data_collection_action" model="ir.actions.act_window">
        <field name="name">Data Collections</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general_audit_data_collection</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_grp_type': 1}</field>
    </record>

    <menuitem
        id="general_audit_data_collection_menu"
        name="Data Collections"
        parent="general_audit_data_collection_menu_root"
        action="general_audit_data_collection_action"
        sequence="1"
        groups="general_audit_data_collection_group"
    />

</odoo>
