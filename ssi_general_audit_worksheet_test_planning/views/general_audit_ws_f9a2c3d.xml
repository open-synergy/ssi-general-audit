<odoo>

    <!-- ================================================================
         DETAIL MODEL VIEWS
         ================================================================ -->

    <!-- DETAIL LIST VIEW (default list of the Details tab) -->
    <record id="general_audit_ws_f9a2c3d_detail_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f9a2c3d.detail tree</field>
        <field name="model">general_audit_ws_f9a2c3d.detail</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="false" delete="false">
                <field name="currency_id" invisible="1" />
                <field name="standard_detail_id" readonly="1" />
                <field name="type_id" readonly="1" />
                <field name="balance" readonly="1" />
                <field name="performance_materiality" readonly="1" />
                <field name="romm" readonly="1" />
                <field
                    name="pr_assersion_type_ids"
                    widget="many2many_tags"
                    string="Assersion Types"
                    readonly="1"
                />
                <field name="ap_result" readonly="1" />
                <field name="timing_id" options="{'no_create': True}" />
                <field name="extent_id" options="{'no_create': True}" />
                <field
                    name="technique_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </tree>
        </field>
    </record>

    <!-- ================================================================
         WORKSHEET VIEWS
         ================================================================ -->

    <!-- SEARCH VIEW -->
    <record id="general_audit_ws_f9a2c3d_view_search" model="ir.ui.view">
        <field name="name">general_audit_ws_f9a2c3d search</field>
        <field name="model">general_audit_ws_f9a2c3d</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="general_audit_ws_f9a2c3d_view_tree" model="ir.ui.view">
        <field name="name">general_audit_ws_f9a2c3d tree</field>
        <field name="model">general_audit_ws_f9a2c3d</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_tree"
        />
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="general_audit_ws_f9a2c3d_view_form" model="ir.ui.view">
        <field name="name">general_audit_ws_f9a2c3d form</field>
        <field name="model">general_audit_ws_f9a2c3d</field>
        <field name="priority" eval="100" />
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="ssi_general_audit.general_audit_worksheet_mixin_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[1]" position="before">
                    <page name="detail" string="Details">
                        <button
                            name="action_load_detail"
                            type="object"
                            string="Detail"
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', 'not in', ['open'])]}"
                        />
                        <field name="detail_ids" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ACTION -->
    <record id="general_audit_ws_f9a2c3d_action" model="ir.actions.act_window">
        <field name="name">Test of Detail Planning</field>
        <field name="res_model">general_audit_ws_f9a2c3d</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem
        id="general_audit_ws_f9a2c3d_menu"
        name="Test of Detail Planning"
        parent="ssi_general_audit.menu_rr_substantive_test"
        action="general_audit_ws_f9a2c3d_action"
        sequence="2"
        groups="general_audit_ws_f9a2c3d_viewer_group"
    />

</odoo>
